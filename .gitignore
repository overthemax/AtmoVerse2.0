# AtmoVerse 2.0 - Git Ignore File

# Backup files
*.bak
*.backup
*.old
*.tmp
*~

# Log files
*.log
build.log
debug.log

# IDE files
.vscode/
.idea/
*.code-workspace
.DS_Store

# Arduino IDE
*.elf
*.eep
*.hex
*.bin
*.map

# Build artifacts
build/
*.o
*.a
*.so

# OS files
Thumbs.db
desktop.ini
.Spotlight-V100
.Trashes

# Editor swap files
*.swp
*.swo

# Personal settings: conf.json lives on the SD card only, never in the repository

# Python caches
__pycache__/
*.py[cod]

# Node modules
node_modules/

# Temporary folders
temp/
tmp/

# Arduino IoT Cloud credentials: never in git
CloudSecrets.h

# Private literary clock quotes: on the SD card only, never on GitHub
# (the folder was called orari before 2.1.17)
clock/
sd_files/clock/
orari/
sd_files/orari/
quotes.csv

# CAD drafts and temporary results (Amagine3D)
cad/.amagine3d-drafts/
cad/*.json
