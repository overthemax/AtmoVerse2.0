return;
} else if (path == "/add-quote" && method == "POST") {
// ...

// Reindirizza le richieste da /add-quote all'endpoint API corretto
String body = "";
while (client.available()) body += (char)client.read();

// Prepara un nuovo body in formato JSON
int quoteIndex = body.indexOf("quote=");
int authorIndex = body.indexOf("author=");
int categoryIndex = body.indexOf("category=");

String quote = "";
String author = "";
String category = "any"; // Default

if (quoteIndex != -1) {
  int startQuote = quoteIndex + 6;
  int endQuote = body.indexOf("&", startQuote);
  if (endQuote == -1) endQuote = body.length();
  quote = body.substring(startQuote, endQuote);
  quote = urldecode(quote); // Decodifica URL
}

if (authorIndex != -1) {
  int startAuthor = authorIndex + 7;
  int endAuthor = body.indexOf("&", startAuthor);
  if (endAuthor == -1) endAuthor = body.length();
  author = body.substring(startAuthor, endAuthor);
  author = urldecode(author); // Decodifica URL
}

if (categoryIndex != -1) {
  int startCat = categoryIndex + 9;
  int endCat = body.indexOf("&", startCat);
  if (endCat == -1) endCat = body.length();
  category = body.substring(startCat, endCat);
}

String combinedQuote = "\"" + quote + "\" - " + author;

// Crea un nuovo JSON per l'API quotes
String jsonBody = "{\"cat\":\"" + category + "\",\"quote\":\"" + combinedQuote + "\"}";

// Inizializza la SD con tentativi multipli
int retries = 3;
bool sdOk = false;

while (retries > 0 && !sdOk) {
  sdOk = SD.begin(5);
  if (!sdOk) {
    delay(100);
    retries--;
  }
}

if (!sdOk) {
  sendJsonResponse(client, "{\"success\":false,\"message\":\"SD non disponibile\"}");
  return;
}

// Leggi prima il contenuto esistente
DynamicJsonDocument doc(4096);
if (SD.exists("/quotes.json")) {
  File f = SD.open("/quotes.json", FILE_READ);
  if (f) {
    deserializeJson(doc, f);
    bool saved = saveConfig();
    Serial.println("[DEBUG] Risultato saveConfig(): " + String(saved ? "SUCCESS" : "FAILED"));
    
    // Prepara la risposta
    if (saved) {
      Serial.println("[DEBUG] ✓ CONFIGURAZIONE SALVATA CON SUCCESSO");
      Serial.println("[SETTINGS] Configurazione salvata con successo su SD");
      sendJsonResponse(client, "{\"success\":true,\"message\":\"Configurazione salvata con successo\"}");
      
      // Attendi per assicurarsi che la risposta venga inviata e che i messaggi siano visibili sul monitor seriale
      delay(5000);
      
      // Chiudi tutte le connessioni WiFi
      WiFi.disconnect(true);
      if (apMode) {
        WiFi.softAPdisconnect(true);
      }
      
      // Riavvia ESP32
      delay(1000);
      ESP.restart();
    } else {
      Serial.println("[DEBUG] ✗ ERRORE SALVATAGGIO CONFIGURAZIONE");
      Serial.println("[DEBUG] Verifica i permessi di scrittura e lo spazio disponibile sulla SD");
      Serial.println("[SETTINGS] ERRORE: Salvataggio configurazione su SD fallito");
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Errore nel salvataggio della configurazione\"}");
    }
  }
  
  if (path == "/api/quotes" && method == "GET") {
    // --- GET citazione per categoria ---
    // Estrai il parametro della categoria
    String cat = "Other";
    int catIdx = params.indexOf("cat=");
    if(catIdx!=-1) {
      int endIdx = params.indexOf('&',catIdx);
      cat = params.substring(catIdx+4, endIdx==-1?params.length():endIdx);
    }
    
    // Inizializza la SD con tentativi multipli
    int retries = 3;
    bool sdOk = false;
    
    while (retries > 0 && !sdOk) {
      sdOk = SD.begin(5);
      if (!sdOk) {
        delay(100);
        retries--;
      }
    }
    
    if (!sdOk) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"SD card non disponibile\"}");
      return;
    }
    
    // Verifica se il file esiste
    if (!SD.exists("/quotes.json")) {
      sendJsonResponse(client, "{\"success\":true,\"quote\":\"\"}");
      return;
    }
    
    // Apri il file e leggi
    File f = SD.open("/quotes.json", FILE_READ);
    String quote = "";
    
    if (!f) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Errore apertura file\"}");
      return;
    }
    
    // Se il file è vuoto
    if (f.size() == 0) {
      f.close();
      sendJsonResponse(client, "{\"success\":true,\"quote\":\"\"}");
      return;
    }
    
    // Deserializza
    DynamicJsonDocument doc(4096);
    DeserializationError err = deserializeJson(doc, f);
    f.close();
    
    if (err) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Errore lettura file JSON\"}");
      return;
    }
    
    // Estrai la citazione
    if (doc.containsKey(cat)) {
      quote = doc[cat].as<String>();
    }
    
    // Invia risposta
    String resp = "{\"success\":true,\"quote\":\"" + quote + "\"}";
    sendJsonResponse(client, resp);
    return;
  }
  
  if (path == "/edit") {
    // Pagina di modifica delle citazioni con stile minimalista
    sendResponse(client, "text/html", generateMinimalQuotesPage());
    return;
  }
  
  if (path == "/info" && method == "GET") {
    // Utilizziamo la pagina informativa per mostrare i dettagli del sistema
    sendResponse(client, "text/html", generateMinimalInfoPage(), 200);
    return;
  }
  
  if (path == "/add-quote" && method == "POST") {
    // Reindirizza le richieste da /add-quote all'endpoint API corretto
    String body = "";
    while (client.available()) body += (char)client.read();
    
    // Prepara un nuovo body in formato JSON
    int quoteIndex = body.indexOf("quote=");
    int authorIndex = body.indexOf("author=");
    int categoryIndex = body.indexOf("category=");
    
    String quote = "";
    String author = "";
    String category = "any"; // Default
    
    if (quoteIndex != -1) {
      int startQuote = quoteIndex + 6;
      int endQuote = body.indexOf("&", startQuote);
      if (endQuote == -1) endQuote = body.length();
      quote = body.substring(startQuote, endQuote);
      quote = urldecode(quote); // Decodifica URL
    }
    
    if (authorIndex != -1) {
      int startAuthor = authorIndex + 7;
      int endAuthor = body.indexOf("&", startAuthor);
      if (endAuthor == -1) endAuthor = body.length();
      author = body.substring(startAuthor, endAuthor);
      author = urldecode(author); // Decodifica URL
    }
    
    if (categoryIndex != -1) {
      int startCat = categoryIndex + 9;
      int endCat = body.indexOf("&", startCat);
      if (endCat == -1) endCat = body.length();
      category = body.substring(startCat, endCat);
    }
    
    String combinedQuote = "\"" + quote + "\" - " + author;
    
    // Crea un nuovo JSON per l'API quotes
    String jsonBody = "{\"cat\":\"" + category + "\",\"quote\":\"" + combinedQuote + "\"}";
    
    // Inizializza la SD con tentativi multipli
    int retries = 3;
    bool sdOk = false;
    
    while (retries > 0 && !sdOk) {
      sdOk = SD.begin(5);
      if (!sdOk) {
        delay(100);
        retries--;
      }
    }
    
    if (!sdOk) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"SD non disponibile\"}");
      return;
    }
    
    // Leggi prima il contenuto esistente
    DynamicJsonDocument doc(4096);
    if (SD.exists("/quotes.json")) {
      File f = SD.open("/quotes.json", FILE_READ);
      if (f) {
        deserializeJson(doc, f);
        f.close();
      }
    }
    
    // Aggiorna il documento JSON - usando un array per ogni categoria
    // Se la categoria non esiste o non è un array, creiamo un nuovo array
    if (!doc.containsKey(category) || !doc[category].is<JsonArray>()) {
      doc[category] = JsonArray();
    }
    
    // Aggiungiamo la nuova citazione all'array della categoria
    doc[category].add(combinedQuote);
    
    // Scrivi il file (prima rimuovi quello esistente per evitare sovrascritture parziali)
    if (SD.exists("/quotes.json")) {
      SD.remove("/quotes.json");
    }
    
    // Logging per debug
    Serial.println("[QUOTES] Aggiunta nuova citazione alla categoria: " + category);
    
    // Apri il file in modalità scrittura
    File wf = SD.open("/quotes.json", FILE_WRITE);
    if (!wf) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Errore scrittura file\"}");
      return;
    }
    
    // Scrivi i dati
    bool writeSuccess = serializeJson(doc, wf);
    wf.close();
    
    if (!writeSuccess) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Errore scrittura JSON\"}");
      return;
    }
    
    // Reindirizza alla pagina di modifica dopo il salvataggio
    client.println("HTTP/1.1 302 Found");
    client.println("Location: /edit");
    client.println();
    return;
  }
  
  if (path == "/api/quotes" && method == "POST") {
    // --- POST salva citazione ---
    String body = "";
    while (client.available()) body += (char)client.read();
    DynamicJsonDocument req(1024);
    DeserializationError err = deserializeJson(req, body);
    if (err) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"JSON non valido\"}");
      return;
    }
    String cat = req["cat"] | "Other";
    String quote = req["quote"] | "";
    // Inizializza la SD con tentativi multipli
    int retries = 3;
    bool sdOk = false;
    
    while (retries > 0 && !sdOk) {
      sdOk = SD.begin(5);
      if (!sdOk) {
        delay(100);
        retries--;
      }
    }
    
    if (!sdOk) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"SD non disponibile\"}");
      return;
    }
    
    // Leggi prima il contenuto esistente
    DynamicJsonDocument doc(4096);
    if (SD.exists("/quotes.json")) {
      File f = SD.open("/quotes.json", FILE_READ);
      if (f) {
        deserializeJson(doc, f);
        f.close();
      }
    }
    
    // Aggiorna il documento JSON - usando un array per ogni categoria
    // Se la categoria non esiste o non è un array, creiamo un nuovo array
    if (!doc.containsKey(cat) || !doc[cat].is<JsonArray>()) {
      doc[cat] = JsonArray();
    }
    
    // Aggiungiamo la nuova citazione all'array della categoria
    doc[cat].add(quote);
    
    // Scrivi il file (prima rimuovi quello esistente per evitare sovrascritture parziali)
    if (SD.exists("/quotes.json")) {
      SD.remove("/quotes.json");
    }
    
    // Logging per debug
    Serial.println("[QUOTES] Aggiunta nuova citazione alla categoria: " + cat);
    
    // Apri il file in modalità scrittura
    File wf = SD.open("/quotes.json", FILE_WRITE);
    if (!wf) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Errore scrittura file\"}");
      return;
    }
    
    // Scrivi i dati
    bool writeSuccess = serializeJson(doc, wf);
    wf.close();
    
    if (!writeSuccess) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Errore scrittura JSON\"}");
      return;
    }
    sendJsonResponse(client, "{\"success\":true}");
    return;
  }
  
  if (path == "/api/quotes/delete" && method == "POST") {
    // --- POST elimina citazione ---
    String body = "";
    while (client.available()) body += (char)client.read();
    DynamicJsonDocument req(1024);
    DeserializationError err = deserializeJson(req, body);
    if (err) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"JSON non valido\"}");
      return;
    }
    
    String cat = req["cat"] | "";
    int index = req["index"] | -1;
    
    if (cat.isEmpty() || index < 0) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Categoria o indice non validi\"}");
      return;
    }
    
    // Inizializza la SD con tentativi multipli
    int retries = 3;
    bool sdOk = false;
    
    while (retries > 0 && !sdOk) {
      sdOk = SD.begin(5);
      if (!sdOk) {
        delay(100);
        retries--;
      }
    }
    
    if (!sdOk) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"SD non disponibile\"}");
      return;
    }
    
    // Leggi il contenuto esistente
    DynamicJsonDocument doc(4096);
    if (SD.exists("/quotes.json")) {
      File f = SD.open("/quotes.json", FILE_READ);
      if (f) {
        deserializeJson(doc, f);
        f.close();
      }
    } else {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"File citazioni non trovato\"}");
      return;
    }
    
    // Verifica che la categoria esista e sia un array
    if (!doc.containsKey(cat) || !doc[cat].is<JsonArray>()) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Categoria non valida o non contiene citazioni\"}");
      return;
    }
    
    // Verifica che l'indice sia valido
    if (index >= doc[cat].size()) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Indice non valido\"}");
      return;
    }
    
    // Rimuovi l'elemento dall'array
    JsonArray categoryArray = doc[cat].as<JsonArray>();
    JsonArray newArray = doc.createNestedArray(cat);
    
    // Copia tutti gli elementi tranne quello da eliminare
    for (int i = 0; i < categoryArray.size(); i++) {
      if (i != index) {
        newArray.add(categoryArray[i]);
      }
    }
    
    // Scrivi il file aggiornato
    if (SD.exists("/quotes.json")) {
      SD.remove("/quotes.json");
    }
    
    File wf = SD.open("/quotes.json", FILE_WRITE);
    if (!wf) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Errore scrittura file\"}");
      return;
    }
    
    bool writeSuccess = serializeJson(doc, wf);
    wf.close();
    
    if (!writeSuccess) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"Errore scrittura JSON\"}");
      return;
    }
    
    Serial.println("[QUOTES] Eliminata citazione dalla categoria: " + cat + ", indice: " + String(index));
    sendJsonResponse(client, "{\"success\":true,\"message\":\"Citazione eliminata con successo\"}");
    return;
  }
  
  if (path == "/api/quotes/list" && method == "GET") {
    // --- GET lista citazioni ---
    // Estrai la categoria dalla query string se presente
    String cat = "";
    int questionMarkIndex = path.indexOf("?");
    if (questionMarkIndex != -1) {
      String queryString = path.substring(questionMarkIndex + 1);
      int catStartIndex = queryString.indexOf("cat=");
      if (catStartIndex != -1) {
        int valueStartIndex = catStartIndex + 4; // lunghezza di "cat="
        int andIndex = queryString.indexOf("&", valueStartIndex);
        if (andIndex != -1) {
          cat = queryString.substring(valueStartIndex, andIndex);
        } else {
          cat = queryString.substring(valueStartIndex);
        }
      }
    }
    
    // Inizializza la SD con tentativi multipli
    int retries = 3;
    bool sdOk = false;
    
    while (retries > 0 && !sdOk) {
      sdOk = SD.begin(5);
      if (!sdOk) {
        delay(100);
        retries--;
      }
    }
    
    if (!sdOk) {
      sendJsonResponse(client, "{\"success\":false,\"message\":\"SD non disponibile\"}");
      return;
    }
    
    // Preparazione della risposta JSON
    DynamicJsonDocument response(4096);
    response["success"] = true;
    
    if (SD.exists("/quotes.json")) {
      File f = SD.open("/quotes.json", FILE_READ);
      if (f) {
        DynamicJsonDocument doc(4096);
        deserializeJson(doc, f);
        f.close();
        
        // Se è specificata una categoria, restituisci solo quella
        if (!cat.isEmpty()) {
          if (doc.containsKey(cat)) {
            response["quotes"] = doc[cat];
          } else {
            response["quotes"] = JsonArray();
          }
          response["category"] = cat;
        } else {
          // Altrimenti restituisci tutte le categorie
          JsonObject quotes = response.createNestedObject("quotes");
          for (JsonPair p : doc.as<JsonObject>()) {
            quotes[p.key().c_str()] = p.value();
          }
        }
      }
    } else {
      response["quotes"] = JsonArray();
    }
    
    String respStr;
    serializeJson(response, respStr);
    sendJsonResponse(client, respStr);
    return;
  }
  
  if (path == "/api/restart" && method == "POST") {
    // Richiesta di riavvio ricevuta
    
    // Invia risposta positiva
    sendJsonResponse(client, "{\"success\":true,\"message\":\"Riavvio in corso...\"}");
    
    // Chiudi tutte le connessioni WiFi
    WiFi.disconnect(true);
    if (apMode) {
      WiFi.softAPdisconnect(true);
    }
    
    // Attendi che i dati vengano inviati
    delay(500);
    
    // Riavvia ESP32
    ESP.restart();
  } else {
    Serial.println("[API] Funzione API non disponibile");
    sendJsonResponse(client, "{\"error\":\"Funzione non disponibile\"}", 404);
  }
}

// Invia una risposta HTTP generica
void sendResponse(WiFiClient& client, const String& contentType, const String& content, int statusCode) {
  client.println("HTTP/1.1 " + String(statusCode) + " OK");
  client.println("Content-Type: " + contentType);
  client.println("Connection: close");
  
  // Imposta header per prevenire caching
  client.println("Cache-Control: no-cache, no-store, must-revalidate");
  client.println("Pragma: no-cache");
  client.println("Expires: 0");
  
  client.println();
  client.println(content);
  
  // Assicurati che tutti i dati vengano inviati
  client.flush();
  
  // Disconnetti il client
  client.stop();
}

// Invia una risposta JSON
void sendJsonResponse(WiFiClient& client, const String& jsonContent, int statusCode) {
  sendResponse(client, "application/json", jsonContent, statusCode);
}

// Invia un reindirizzamento HTTP 302
void sendRedirect(WiFiClient& client, const String& location) {
  client.println("HTTP/1.1 302 Found");
  client.println("Location: " + location);
  client.println("Cache-Control: no-cache");
  client.println("Connection: close");
  client.println();
}

// Gestisce la scansione WiFi e restituisce i risultati in JSON
void performWiFiScan(WiFiClient& client) {
  // Inizia la scansione WiFi
  Serial.println("[WIFI-SCAN] Avvio scansione WiFi...");
  int numNetworks = WiFi.scanNetworks();
  Serial.print("[WIFI-SCAN] Scansione completata. Trovate ");
  Serial.print(numNetworks);
  Serial.println(" reti.");
  
  DynamicJsonDocument doc(4096); // Aumenta la dimensione per supportare più reti
  JsonArray networks = doc.createNestedArray("networks");
  
  // Popola l'array JSON con le reti trovate
  for (int i = 0; i < numNetworks; i++) {
    JsonObject network = networks.createNestedObject();
    
    // Informazioni sulla rete
    network["ssid"] = WiFi.SSID(i);
    network["rssi"] = WiFi.RSSI(i);
    
    // Tipo di crittografia
    String encType;
    switch(WiFi.encryptionType(i)) {
      case WIFI_AUTH_OPEN: encType = "Aperta"; break;
      case WIFI_AUTH_WEP: encType = "WEP"; break;
      case WIFI_AUTH_WPA_PSK: encType = "WPA"; break;
      case WIFI_AUTH_WPA2_PSK: encType = "WPA2"; break;
      case WIFI_AUTH_WPA_WPA2_PSK: encType = "WPA/WPA2"; break;
      default: encType = "Sconosciuta";
    }
    network["encryption"] = encType;
    
    // Calcola la qualità del segnale (0-100%)
    int quality = min(max(2 * (WiFi.RSSI(i) + 100), 0L), 100L);
    String qualityText = "Debole";
    
    if (quality > 70) qualityText = "Ottimo";
    else if (quality > 50) qualityText = "Buono";
    else if (quality > 30) qualityText = "Discreto";
    
    network["quality"] = qualityText;
    network["quality_value"] = quality;
  }
  
  // Genera la risposta JSON
  String jsonResponse;
  serializeJson(doc, jsonResponse);
  
  // Invia la risposta JSON (senza intestazioni HTTP, già inviate)
  Serial.println("[WIFI-SCAN] Invio risposta JSON: " + jsonResponse);
  client.print(jsonResponse);
  
  // Libera la memoria
  WiFi.scanDelete();
  
  // Chiudi la connessione
  client.flush();
  client.stop();
  Serial.println("[WIFI-SCAN] Connessione chiusa dopo risposta scansione");
}
