<body>
  <div class="container">
    <div class="header">
      <div class="logo">AtmoVerse 2.0</div>
    </div>
    
    <div class="card">
      <h2>Impostazioni</h2>
      
      <form action="/saveSettings" method="post">
        <div class="form-section">
          <div class="form-section-title">Wi-Fi</div>
          
          <div class="form-group">
            <label for="ssid">SSID Wi-Fi</label>
            <input type="text" id="ssid" name="ssid" value="%SSID%" required>
          </div>
          
          <div class="form-group">
            <label for="password">Password Wi-Fi</label>
            <input type="password" id="password" name="password" value="%PASSWORD%" required>
          </div>
        </div>
        
        <div class="form-section">
          <div class="form-section-title">OpenWeatherMap API</div>
          
          <div class="form-group">
            <label for="api_key">API Key</label>
            <input type="text" id="api_key" name="api_key" value="%API_KEY%" required>
          </div>
          
          <div class="form-group">
