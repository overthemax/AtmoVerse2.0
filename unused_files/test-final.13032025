/*
 * AtmoVerse 2.0 - Versione Ottimizzata con Display E-Ink
 * 
 * Versione: 13.03.2025
 * 
 * Questa versione include:
 * - Tutte le funzionalità originali di AtmoVerse 2.0
 * - Supporto per display e-ink GDEW0583T8 (5.83 pollici)
 * - Ottimizzazioni per ridurre il consumo di memoria
 */

#include <SPI.h>
#include <SD.h>
#include <ArduinoJson.h>
#include <WiFi.h>
#include <WebServer.h>
#include <HTTPClient.h>
#include <DNSServer.h>
#include <time.h>
#include <GxEPD2_BW.h>
#include <Fonts/FreeSans9pt7b.h> // Font più leggero di FreeMonoBold9pt7b

// Definizioni pin
const int SD_CLK_PIN = 27;
const int SD_MISO_PIN = 25;
const int SD_MOSI_PIN = 26;
const int SD_CS_PIN = 15;
const int LED_BLUE = 2;

// Definizione pin e-ink display (DESPI-C02)
#define EPD_BUSY    4    // GPIO04 - busy
#define EPD_RST     16   // GPIO16 - res (reset)
#define EPD_DC      17   // GPIO17 - d/c (data/command)
#define EPD_CS      5    // GPIO05 - cs (chip select)
#define EPD_SCK     18   // GPIO18 - sck (clock)
#define EPD_MOSI    23   // GPIO23 - sdi (data in/MOSI)

// Variabili configurazione
char ssid[40] = "";
char password[40] = "";
char owm_api_key[40] = "";
char owm_city[40] = "";
char owm_country[40] = "";
char timezone[40] = "";
bool dst_enabled = false;

// Flag per indicare se siamo in modalità AP e stato di avvio
bool inAPMode = false;
bool isFirstBoot = true;
unsigned long startTime = 0;

// Captive Portal DNS
DNSServer dnsServer;
const byte DNS_PORT = 53; // Porta standard DNS

// Server Web
WebServer server(80);

// Definizione struttura WeatherData
struct WeatherData {
  float temperature;
  float humidity;
  float windSpeed;
  float pressure; // Aggiunto per pressione atmosferica
  int weatherId = 0;  // ID numerico della condizione meteo
  String weatherCondition;
  String weatherCategory;
  String weatherIconCode;
  String cityName; // Nome della città
  String countryCode; // Codice paese
  String lastUpdate; // Ultimo aggiornamento
};

// Numero massimo di citazioni per categoria
#define MAX_QUOTES_PER_CATEGORY 5

// Definizione struttura per citazioni personalizzate
struct QuotesData {
  // Ogni categoria contiene un array di citazioni
  String thunderstorm[MAX_QUOTES_PER_CATEGORY]; // Temporale
  String drizzle[MAX_QUOTES_PER_CATEGORY];      // Pioggia leggera
  String rain[MAX_QUOTES_PER_CATEGORY];         // Pioggia
  String snow[MAX_QUOTES_PER_CATEGORY];         // Neve
  String clearSky[MAX_QUOTES_PER_CATEGORY];     // Cielo sereno
  String fewClouds[MAX_QUOTES_PER_CATEGORY];    // Poche nuvole
  String scatteredClouds[MAX_QUOTES_PER_CATEGORY]; // Nuvole sparse
  String brokenClouds[MAX_QUOTES_PER_CATEGORY]; // Nuvole abbondanti
  String mist[MAX_QUOTES_PER_CATEGORY];         // Nebbia
  String storm[MAX_QUOTES_PER_CATEGORY];        // Tempesta
  
  // Contatore per tenere traccia del numero di citazioni in ogni categoria
  uint8_t thunderstormCount = 0;
  uint8_t drizzleCount = 0;
  uint8_t rainCount = 0;
  uint8_t snowCount = 0;
  uint8_t clearSkyCount = 0;
  uint8_t fewCloudsCount = 0;
  uint8_t scatteredCloudsCount = 0;
  uint8_t brokenCloudsCount = 0;
  uint8_t mistCount = 0;
  uint8_t stormCount = 0;
};

// Istanze globali
WeatherData currentWeather;
QuotesData customQuotes;

// Forward declarations
String getWeatherQuote(String weatherCategory);
void handleRoot();
void handleSettings();
void handleQuotes();
void handleSaveSettings();
void handleSaveQuotes();
void loadCustomQuotes();
String PROGMEM_getstring(const char* str);
void setupTime();

// Prototipi funzioni display e-ink (implementazioni più avanti nel file)
void initEinkDisplay();
void updateEinkDisplay();
void displayConfigMode();

// ============= IMPLEMENTAZIONE FUNZIONI DISPLAY E-INK =============
// Funzioni ottimizzate per ridurre il consumo di memoria

// Funzione per inizializzare il display e-ink
void initEinkDisplay() {
  Serial.println(F("Init display e-ink"));
  
  // Reset hardware
  pinMode(EPD_RST, OUTPUT);
  digitalWrite(EPD_RST, LOW);
  delay(20);
  digitalWrite(EPD_RST, HIGH);
  delay(100);
  
  // Configurazione SPI
  SPI.begin(EPD_SCK, -1, EPD_MOSI, EPD_CS);
}

// Funzione per aggiornare il display con i dati meteo
void updateEinkDisplay() {
  Serial.println(F("Aggiornamento display"));
  
  // Crea l'oggetto display solo quando necessario (riduce utilizzo memoria)
  GxEPD2_BW<GxEPD2_583_T8, GxEPD2_583_T8::HEIGHT> display(GxEPD2_583_T8(EPD_CS, EPD_DC, EPD_RST, EPD_BUSY));
  
  display.init(0);
  display.setRotation(0);
  display.setFont(&FreeSans9pt7b);
  display.setTextColor(GxEPD_BLACK);
  
  display.setFullWindow();
  display.firstPage();
  do {
    display.fillScreen(GxEPD_WHITE);
    
    // Titolo compatto
    display.setCursor(100, 40);
    display.println(F("AtmoVerse 2.0"));
    
    // Info meteo essenziali
    display.setCursor(30, 100);
    display.print(F("Citta: "));
    display.println(currentWeather.cityName);
    
    display.setCursor(30, 130);
    display.print(F("Temp: "));
    display.print(currentWeather.temperature, 1);
    display.println(F("C"));
    
    display.setCursor(30, 160);
    display.print(F("Umid: "));
    display.print(currentWeather.humidity, 1);
    display.println(F("%"));
    
    display.setCursor(30, 190);
    display.print(F("Press: "));
    display.print(currentWeather.pressure, 0);
    display.println(F("hPa"));
    
    display.setCursor(30, 220);
    display.print(F("Vento: "));
    display.print(currentWeather.windSpeed, 1);
    display.println(F("m/s"));
    
    display.setCursor(30, 250);
    display.print(F("Condizioni: "));
    display.println(currentWeather.weatherCondition);
    
    // Bordo semplice
    display.drawRect(5, 5, display.width()-10, display.height()-10, GxEPD_BLACK);
    
  } while (display.nextPage());
  
  Serial.println(F("Display aggiornato"));
}

// Funzione per visualizzare la modalità configurazione
void displayConfigMode() {
  Serial.println(F("Config mode display"));
  
  // Crea l'oggetto display solo quando necessario
  GxEPD2_BW<GxEPD2_583_T8, GxEPD2_583_T8::HEIGHT> display(GxEPD2_583_T8(EPD_CS, EPD_DC, EPD_RST, EPD_BUSY));
  
  display.init(0);
  display.setRotation(0);
  display.setFont(&FreeSans9pt7b);
  display.setTextColor(GxEPD_BLACK);
  
  display.setFullWindow();
  display.firstPage();
  do {
    display.fillScreen(GxEPD_WHITE);
    display.setCursor(50, 100);
    display.println(F("AtmoVerse 2.0"));
    display.setCursor(50, 150);
    display.println(F("Config Mode"));
    display.setCursor(50, 200);
    display.println(F("SSID: AtmoVerse"));
    display.setCursor(50, 250);
    display.println(F("IP: 192.168.4.1"));
    display.drawRect(5, 5, display.width()-10, display.height()-10, GxEPD_BLACK);
  } while (display.nextPage());
}

// Definizione frontend HTML (versione ottimizzata con meno commenti e spazi)
const char MAIN_PAGE[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
