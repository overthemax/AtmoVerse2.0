</head>
<body>
  <div class="container">
    <div class="header">
      <div class="logo">AtmoVerse 2.0</div>
      <div class="actions">
        <a href="/settings" class="btn">
          <span class="material-icons">settings</span>
          Impostazioni
        </a>
        <a href="/quotes" class="btn">
          <span class="material-icons">format_quote</span>
          Citazioni
        </a>
        <button class="btn" onclick="showSystemInfo()">
          <span class="material-icons">info</span>
          Info
        </button>
      </div>
    </div>
    
    <div class="weather-card">
      <div class="weather-header">
        <div class="location">%CITY%, %COUNTRY%</div>
        <div class="datetime">%DATETIME%</div>
      </div>
      
      <div class="weather-icon">
        <span class="material-icons">%WEATHER_ICON%</span>
      </div>
      
      <div class="temperature">%TEMPERATURE%°C</div>
      <div class="condition">%WEATHER_CONDITION%</div>
      
      <div class="weather-details">
        <div class="detail-item">
          <span class="material-icons detail-icon">water_drop</span>
          <div class="detail-value">%HUMIDITY%%</div>
          <div class="detail-label">Umidità</div>
        </div>
        <div class="detail-item">
          <span class="material-icons detail-icon">air</span>
          <div class="detail-value">%WIND_SPEED% m/s</div>
          <div class="detail-label">Vento</div>
        </div>
        <div class="detail-item">
          <span class="material-icons detail-icon">compress</span>
          <div class="detail-value">%PRESSURE% hPa</div>
          <div class="detail-label">Pressione</div>
        </div>
      </div>
    </div>
    
    <div class="quote-card">
      <div class="quote-category">%QUOTE_CATEGORY%</div>
      <div class="quote-content">%QUOTE_CONTENT%</div>
      <div class="quote-attribution">— AtmoVerse</div>
    </div>
    
    <div class="footer">
      &copy; 2025 AtmoVerse 2.0 — ESP32 Weather Station
    </div>
  </div>
  
  <!-- Modal per info di sistema -->
  <div id="systemInfoModal" class="modal">
    <div class="modal-content">
      <span class="close" onclick="closeSystemInfo()">&times;</span>
      <h2>Informazioni di Sistema</h2>
      
      <div class="system-info-item">
        <div class="system-info-label">Versione Firmware</div>
        <div class="system-info-value">AtmoVerse 2.0 (13.03.2025)</div>
      </div>
      
      <div class="system-info-item">
        <div class="system-info-label">Connessione Wi-Fi</div>
        <div class="system-info-value">%WIFI_STATUS%</div>
      </div>
      
      <div class="system-info-item">
        <div class="system-info-label">Indirizzo IP</div>
        <div class="system-info-value">%IP_ADDRESS%</div>
      </div>
      
      <div class="system-info-item">
        <div class="system-info-label">Memoria libera</div>
        <div class="system-info-value">%FREE_HEAP% bytes</div>
      </div>
      
      <div class="system-info-item">
        <div class="system-info-label">Ultimo aggiornamento meteo</div>
        <div class="system-info-value">%LAST_UPDATE%</div>
      </div>
    </div>
  </div>
  
  <script>
    function showSystemInfo() {
      document.getElementById('systemInfoModal').style.display = 'block';
    }
    
    function closeSystemInfo() {
      document.getElementById('systemInfoModal').style.display = 'none';
    }
    
    window.onclick = function(event) {
      if (event.target == document.getElementById('systemInfoModal')) {
        closeSystemInfo();
      }
    }
  </script>
</body>
</html>
)rawliteral";

// Pagina impostazioni (versione ottimizzata)
const char SETTINGS_PAGE[] PROGMEM = R"rawliteral(
