      flex-direction: column;
      align-items: center;
      padding: 12px;
      border-radius: var(--border-radius);
      background-color: rgba(142, 120, 96, 0.05);
    }
    
    .detail-icon {
      margin-bottom: 8px;
    }
    
    .detail-value {
      font-size: 16px;
      font-weight: 500;
    }
    
    .detail-label {
      font-size: 12px;
      opacity: 0.8;
