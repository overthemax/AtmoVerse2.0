```cpp
void setup() {
  Serial.begin(115200);

  // Inizializza il display e-ink
  initEinkDisplay();

  // Inizializza la connessione Wi-Fi
  WiFi.begin(ssid, password);

  // Attendi la connessione Wi-Fi
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.println("Connessione Wi-Fi in corso...");
  }

  Serial.println("Connesso alla rete Wi-Fi");

  // Inizializza il server web
  server.on("/", handleRoot);
  server.on("/settings", handleSettings);
  server.on("/quotes", handleQuotes);
  server.on("/saveSettings", handleSaveSettings);
  server.on("/saveQuotes", handleSaveQuotes);

  server.begin();

  Serial.println("Server web avviato");

  // Aggiorna il display con i dati meteo
  updateEinkDisplay();
}

void loop() {
  // Gestisci le richieste del server web
  server.handleClient();

  // Aggiorna il display con i dati meteo ogni 10 minuti
  static unsigned long lastUpdate = 0;
  if (millis() - lastUpdate >= 600000) {
    lastUpdate = millis();
    updateEinkDisplay();
  }
}
// Funzione per aggiornare i dati meteo (ottimizzata per memoria)
void updateWeather() {
  Serial.println(F("Aggiornamento dati meteo..."));
  
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println(F("WiFi non connesso, impossibile aggiornare"));
    return;
  }
  
  HTTPClient http;
  String url = "http://api.openweathermap.org/data/2.5/weather?q=";
  url += String(owm_city) + "," + String(owm_country);
  url += "&units=metric&appid=" + String(owm_api_key);
  
  http.begin(url);
  int httpCode = http.GET();
  
  if (httpCode == 200) {
    String payload = http.getString();
    
    // Usa una capacità ridotta per il JSON per risparmiare memoria
    DynamicJsonDocument doc(1024);
    deserializeJson(doc, payload);
    
    // Estrai i dati dal JSON
    currentWeather.temperature = doc["main"]["temp"];
    currentWeather.humidity = doc["main"]["humidity"];
    currentWeather.pressure = doc["main"]["pressure"];
    currentWeather.windSpeed = doc["wind"]["speed"];
    currentWeather.weatherId = doc["weather"][0]["id"];
    currentWeather.weatherCondition = doc["weather"][0]["description"].as<String>();
    currentWeather.weatherCategory = doc["weather"][0]["main"].as<String>();
    currentWeather.weatherIconCode = doc["weather"][0]["icon"].as<String>();
    currentWeather.cityName = doc["name"].as<String>();
    currentWeather.countryCode = doc["sys"]["country"].as<String>();
    
    // Aggiorna il timestamp
    time_t now;
    struct tm timeinfo;
    time(&now);
    localtime_r(&now, &timeinfo);
    char datetime[30];
    strftime(datetime, sizeof(datetime), "%d/%m/%Y %H:%M", &timeinfo);
    currentWeather.lastUpdate = String(datetime);
    
    Serial.println(F("Dati meteo aggiornati con successo"));
  } else {
    Serial.println(F("Errore nel recupero dei dati meteo"));
  }
  
  http.end();
}

// Funzione principale di setup
void setup() {
  Serial.begin(115200);
  pinMode(LED_BLUE, OUTPUT);
  digitalWrite(LED_BLUE, HIGH); // Accendi il LED per indicare avvio
  
  Serial.println(F("\n\nAtmoVerse 2.0 - Avvio"));
  
  // Inizializza SD Card
  SPI.begin(SD_CLK_PIN, SD_MISO_PIN, SD_MOSI_PIN, SD_CS_PIN);
  
  bool sdInitialized = false;
  int sdRetryCount = 0;
  const int maxSDRetries = 3;
  
  while (!sdInitialized && sdRetryCount < maxSDRetries) {
    Serial.println(F("Inizializzazione SD Card..."));
    sdInitialized = SD.begin(SD_CS_PIN);
    
    if (!sdInitialized) {
      Serial.println(F("Errore inizializzazione SD Card, riprovo..."));
      sdRetryCount++;
      delay(1000);
    }
  }
  
  if(!sdInitialized) {
    Serial.println(F("Errore SD Card dopo ripetuti tentativi!"));
    digitalWrite(LED_BLUE, LOW); // Spegni il LED per indicare errore
    startAPMode();
  } else {
    // SD card inizializzata correttamente
    Serial.println(F("SD Card inizializzata correttamente"));
    
    // Inizializza il display e-ink
    initEinkDisplay();
    
    if(!loadConfig()) {
      Serial.println(F("Configurazione non trovata!"));
      createDefaultConfig();
    }
    
    // Carica le citazioni personalizzate
    loadCustomQuotes();
    
    if (strlen(ssid) > 0 && strlen(password) > 0) {
      Serial.println(F("Connessione alla rete WiFi..."));
      Serial.print(F("SSID: "));
      Serial.println(ssid);
      
      WiFi.mode(WIFI_STA);
      WiFi.begin(ssid, password);
      
      // Attendi la connessione al WiFi
      int wifiRetryCount = 0;
      const int maxWiFiRetries = 20; // 20 secondi di attesa
      
      while (WiFi.status() != WL_CONNECTED && wifiRetryCount < maxWiFiRetries) {
        delay(1000);
        Serial.print(F("."));
        wifiRetryCount++;
      }
      
      if (WiFi.status() != WL_CONNECTED) {
        Serial.println(F("\nImpossibile connettersi al WiFi"));
        startAPMode();
      } else {
        Serial.println(F("\nConnesso alla rete WiFi"));
        Serial.print(F("Indirizzo IP: "));
        Serial.println(WiFi.localIP());
        
        inAPMode = false;
      }
    } else {
      Serial.println(F("Credenziali WiFi non configurate"));
      startAPMode();
    }
    
    // Configura il server web
    server.on("/", handleRoot);
    server.on("/settings", handleSettings);
    server.on("/quotes", handleQuotes);
    server.on("/saveSettings", handleSaveSettings);
    server.on("/saveQuotes", handleSaveQuotes);
    
    // Avvia il server web
    server.begin();
    Serial.println(F("Server web avviato"));
    
    if(WiFi.status() == WL_CONNECTED) {
      // Configura NTP per l'ora
      setupTime();
      // Aggiorna i dati meteo
      updateWeather();
      // Aggiorna il display e-ink con i dati meteo
      updateEinkDisplay();
    } else if (inAPMode) {
      // Mostra modalità configurazione sul display
      displayConfigMode();
    }
  }
}

// Funzione per avviare la modalità AP
void startAPMode() {
  Serial.println(F("Avvio modalità AP"));
  
  inAPMode = true;
  
  // Configura l'Access Point
  WiFi.mode(WIFI_AP);
  WiFi.softAP("AtmoVerse", "");
  
  // Configura il server DNS per il captive portal
  dnsServer.start(DNS_PORT, "*", WiFi.softAPIP());
  
  // Mostra la modalità config sul display e-ink
  displayConfigMode();
// Funzione per gestire la richiesta alla root
void handleRoot() {
  String html = PROGMEM_getstring(MAIN_PAGE);
  
  // Sostituisci i segnaposto con i dati meteo
  html.replace("%CITY%", currentWeather.cityName);
  html.replace("%COUNTRY%", currentWeather.countryCode);
  html.replace("%TEMPERATURE%", String(currentWeather.temperature, 1));
  html.replace("%HUMIDITY%", String(currentWeather.humidity, 1));
  html.replace("%WIND_SPEED%", String(currentWeather.windSpeed, 1));
  html.replace("%PRESSURE%", String(currentWeather.pressure, 0));
  html.replace("%WEATHER_CONDITION%", currentWeather.weatherCondition);
  
  // Determina l'icona in base al weatherId
  String weatherIcon = "cloud";
  if (currentWeather.weatherId >= 200 && currentWeather.weatherId < 300) {
    weatherIcon = "flash_on"; // Temporale
  } else if (currentWeather.weatherId >= 300 && currentWeather.weatherId < 400) {
    weatherIcon = "grain"; // Pioggerella
  } else if (currentWeather.weatherId >= 500 && currentWeather.weatherId < 600) {
    weatherIcon = "water"; // Pioggia
  } else if (currentWeather.weatherId >= 600 && currentWeather.weatherId < 700) {
    weatherIcon = "ac_unit"; // Neve
  } else if (currentWeather.weatherId >= 700 && currentWeather.weatherId < 800) {
    weatherIcon = "dehaze"; // Nebbia
  } else if (currentWeather.weatherId == 800) {
    weatherIcon = "wb_sunny"; // Sereno
  } else if (currentWeather.weatherId > 800 && currentWeather.weatherId < 900) {
    weatherIcon = "cloud"; // Nuvoloso
  }
  
  html.replace("%WEATHER_ICON%", weatherIcon);
  
  // Ottieni una citazione in base alla categoria meteo
  String quote = getWeatherQuote(currentWeather.weatherCategory);
  html.replace("%QUOTE_CONTENT%", quote);
  html.replace("%QUOTE_CATEGORY%", currentWeather.weatherCategory);
  
  // Ottieni l'ora corrente
  time_t now;
  struct tm timeinfo;
  time(&now);
  localtime_r(&now, &timeinfo);
  char datetime[30];
  strftime(datetime, sizeof(datetime), "%d/%m/%Y %H:%M", &timeinfo);
  html.replace("%DATETIME%", String(datetime));
  
  // Info di sistema
  html.replace("%WIFI_STATUS%", WiFi.status() == WL_CONNECTED ? "Connesso" : "Disconnesso");
  html.replace("%IP_ADDRESS%", WiFi.localIP().toString());
  html.replace("%FREE_HEAP%", String(ESP.getFreeHeap()));
  html.replace("%LAST_UPDATE%", currentWeather.lastUpdate);
  
  server.send(200, "text/html", html);
}

// Funzione per mostrare la pagina delle impostazioni
void handleSettings() {
  String html = PROGMEM_getstring(SETTINGS_PAGE);
  
  // Sostituisci i segnaposto con i valori attuali
  html.replace("%SSID%", String(ssid));
  html.replace("%PASSWORD%", String(password));
  html.replace("%API_KEY%", String(owm_api_key));
  html.replace("%CITY%", String(owm_city));
  html.replace("%COUNTRY%", String(owm_country));
  html.replace("%TIMEZONE%", String(timezone));
  html.replace("%DST_CHECKED%", dst_enabled ? "checked" : "");
  
  server.send(200, "text/html", html);
}

// Funzione per mostrare la pagina delle citazioni
void handleQuotes() {
  // Implementazione ottimizzata per risparmiare memoria
  String html = PROGMEM_getstring(QUOTES_PAGE);
  
  // Sostituisci i segnaposto con le citazioni attuali
  if (customQuotes.thunderstormCount > 0) {
    html.replace("%THUNDERSTORM_QUOTE_1%", customQuotes.thunderstorm[0]);
  } else {
    html.replace("%THUNDERSTORM_QUOTE_1%", "");
  }
  
  if (customQuotes.rainCount > 0) {
    html.replace("%RAIN_QUOTE_1%", customQuotes.rain[0]);
  } else {
    html.replace("%RAIN_QUOTE_1%", "");
  }
  
  if (customQuotes.snowCount > 0) {
    html.replace("%SNOW_QUOTE_1%", customQuotes.snow[0]);
  } else {
    html.replace("%SNOW_QUOTE_1%", "");
  }
  
  if (customQuotes.clearSkyCount > 0) {
    html.replace("%CLEAR_QUOTE_1%", customQuotes.clearSky[0]);
  } else {
    html.replace("%CLEAR_QUOTE_1%", "");
  }
  
  if (customQuotes.brokenCloudsCount > 0) {
    html.replace("%CLOUDS_QUOTE_1%", customQuotes.brokenClouds[0]);
  } else {
    html.replace("%CLOUDS_QUOTE_1%", "");
  }
  
  server.send(200, "text/html", html);
}

// Funzione per salvare le impostazioni
void handleSaveSettings() {
  if (server.hasArg("ssid")) {
    server.arg("ssid").toCharArray(ssid, sizeof(ssid));
  }
  
  if (server.hasArg("password")) {
    server.arg("password").toCharArray(password, sizeof(password));
  }
  
  if (server.hasArg("api_key")) {
    server.arg("api_key").toCharArray(owm_api_key, sizeof(owm_api_key));
  }
  
  if (server.hasArg("city")) {
    server.arg("city").toCharArray(owm_city, sizeof(owm_city));
  }
  
  if (server.hasArg("country")) {
    server.arg("country").toCharArray(owm_country, sizeof(owm_country));
  }
  
  if (server.hasArg("timezone")) {
    server.arg("timezone").toCharArray(timezone, sizeof(timezone));
  }
  
  dst_enabled = server.hasArg("dst_enabled");
  
  // Salva la configurazione su SD
  saveConfig();
  
  // Riconnetti al WiFi se necessario
  if (WiFi.SSID() != String(ssid)) {
    WiFi.disconnect();
    delay(500);
    WiFi.begin(ssid, password);
  }
  
  // Reindirizza alla pagina principale
  server.sendHeader("Location", "/");
  server.send(302, "text/plain", "Redirecting...");
}

// Funzione per salvare le citazioni
void handleSaveQuotes() {
  // Implementazione ottimizzata per risparmiare memoria
  bool quotesChanged = false;
  
  if (server.hasArg("clear1") && server.arg("clear1") != "") {
    customQuotes.clearSky[0] = server.arg("clear1");
    customQuotes.clearSkyCount = max(1, customQuotes.clearSkyCount);
    quotesChanged = true;
  }
  
  if (server.hasArg("clouds1") && server.arg("clouds1") != "") {
    customQuotes.brokenClouds[0] = server.arg("clouds1");
    customQuotes.brokenCloudsCount = max(1, customQuotes.brokenCloudsCount);
    quotesChanged = true;
  }
  
  if (server.hasArg("rain1") && server.arg("rain1") != "") {
    customQuotes.rain[0] = server.arg("rain1");
    customQuotes.rainCount = max(1, customQuotes.rainCount);
    quotesChanged = true;
  }
  
  if (server.hasArg("snow1") && server.arg("snow1") != "") {
    customQuotes.snow[0] = server.arg("snow1");
    customQuotes.snowCount = max(1, customQuotes.snowCount);
    quotesChanged = true;
  }
  
  if (server.hasArg("thunderstorm1") && server.arg("thunderstorm1") != "") {
    customQuotes.thunderstorm[0] = server.arg("thunderstorm1");
    customQuotes.thunderstormCount = max(1, customQuotes.thunderstormCount);
    quotesChanged = true;
  }
  
  if (quotesChanged) {
    // Salva le citazioni su SD
    saveQuotes();
  }
  
  // Reindirizza alla pagina principale
  server.sendHeader("Location", "/");
  server.send(302, "text/plain", "Redirecting...");
}

// Funzione per salvare le citazioni su SD
void saveQuotes() {
  // Rimuovi file esistente
  if (SD.exists("/quotes.json")) {
    SD.remove("/quotes.json");
  }
  
  File quotesFile = SD.open("/quotes.json", FILE_WRITE);
  if (!quotesFile) {
    Serial.println(F("Errore nell'apertura del file delle citazioni"));
    return;
  }
  
  // Usa una capacità ridotta per il JSON per risparmiare memoria
  DynamicJsonDocument doc(1024);
  
  // Aggiungi solo categorie con citazioni
  if (customQuotes.thunderstormCount > 0) {
    JsonArray thunderstorm = doc.createNestedArray("thunderstorm");
    for (int i = 0; i < customQuotes.thunderstormCount; i++) {
      thunderstorm.add(customQuotes.thunderstorm[i]);
    }
  }
  
  if (customQuotes.drizzleCount > 0) {
    JsonArray drizzle = doc.createNestedArray("drizzle");
    for (int i = 0; i < customQuotes.drizzleCount; i++) {
      drizzle.add(customQuotes.drizzle[i]);
    }
  }
  
  if (customQuotes.rainCount > 0) {
    JsonArray rain = doc.createNestedArray("rain");
    for (int i = 0; i < customQuotes.rainCount; i++) {
      rain.add(customQuotes.rain[i]);
    }
  }
  
  if (customQuotes.snowCount > 0) {
    JsonArray snow = doc.createNestedArray("snow");
    for (int i = 0; i < customQuotes.snowCount; i++) {
      snow.add(customQuotes.snow[i]);
    }
  }
  
  if (customQuotes.clearSkyCount > 0) {
    JsonArray clearSky = doc.createNestedArray("clearSky");
    for (int i = 0; i < customQuotes.clearSkyCount; i++) {
      clearSky.add(customQuotes.clearSky[i]);
    }
  }
  
  if (customQuotes.brokenCloudsCount > 0) {
    JsonArray brokenClouds = doc.createNestedArray("brokenClouds");
    for (int i = 0; i < customQuotes.brokenCloudsCount; i++) {
      brokenClouds.add(customQuotes.brokenClouds[i]);
    }
  }
  
  if (serializeJson(doc, quotesFile) == 0) {
    Serial.println(F("Errore nella scrittura delle citazioni"));
  }
  
  quotesFile.close();
  Serial.println(F("Citazioni salvate con successo"));
}

// Funzione per caricare le citazioni da SD
void loadCustomQuotes() {
  if (!SD.exists("/quotes.json")) {
    Serial.println(F("File delle citazioni non trovato"));
    
    // Imposta citazioni predefinite
    customQuotes.clearSky[0] = F("La vita è come un cielo sereno: bella, luminosa e piena di possibilità.");
    customQuotes.clearSkyCount = 1;
    
    customQuotes.brokenClouds[0] = F("Come nuvole passeggere, i problemi vanno e vengono.");
    customQuotes.brokenCloudsCount = 1;
    
    customQuotes.rain[0] = F("La pioggia ci ricorda che dopo ogni tempesta, torna sempre il sereno.");
    customQuotes.rainCount = 1;
    
    customQuotes.snow[0] = F("Ogni fiocco di neve è diverso, proprio come ogni momento della vita.");
    customQuotes.snowCount = 1;
    
    customQuotes.thunderstorm[0] = F("I temporali, come le difficoltà, ci rendono più forti.");
    customQuotes.thunderstormCount = 1;
    
    return;
  }
  
  File quotesFile = SD.open("/quotes.json", FILE_READ);
  if (!quotesFile) {
    Serial.println(F("Errore nell'apertura del file delle citazioni"));
    return;
  }
  
  // Usa una capacità ridotta per il JSON per risparmiare memoria
  DynamicJsonDocument doc(1024);
  
  DeserializationError error = deserializeJson(doc, quotesFile);
  if (error) {
    Serial.println(F("Errore nel parsing del file delle citazioni"));
    quotesFile.close();
    return;
  }
  
  // Inizializza contatori
  customQuotes.thunderstormCount = 0;
  customQuotes.drizzleCount = 0;
  customQuotes.rainCount = 0;
  customQuotes.snowCount = 0;
  customQuotes.clearSkyCount = 0;
  customQuotes.brokenCloudsCount = 0;
  
  // Carica le citazioni per ogni categoria
  if (doc.containsKey("thunderstorm")) {
    JsonArray thunderstorm = doc["thunderstorm"];
    customQuotes.thunderstormCount = min((size_t)MAX_QUOTES_PER_CATEGORY, thunderstorm.size());
    for (int i = 0; i < customQuotes.thunderstormCount; i++) {
      customQuotes.thunderstorm[i] = thunderstorm[i].as<String>();
    }
  }
  
  if (doc.containsKey("drizzle")) {
    JsonArray drizzle = doc["drizzle"];
    customQuotes.drizzleCount = min((size_t)MAX_QUOTES_PER_CATEGORY, drizzle.size());
    for (int i = 0; i < customQuotes.drizzleCount; i++) {
      customQuotes.drizzle[i] = drizzle[i].as<String>();
    }
  }
  
  if (doc.containsKey("rain")) {
    JsonArray rain = doc["rain"];
    customQuotes.rainCount = min((size_t)MAX_QUOTES_PER_CATEGORY, rain.size());
    for (int i = 0; i < customQuotes.rainCount; i++) {
      customQuotes.rain[i] = rain[i].as<String>();
    }
  }
  
  if (doc.containsKey("snow")) {
    JsonArray snow = doc["snow"];
    customQuotes.snowCount = min((size_t)MAX_QUOTES_PER_CATEGORY, snow.size());
    for (int i = 0; i < customQuotes.snowCount; i++) {
      customQuotes.snow[i] = snow[i].as<String>();
    }
  }
  
  if (doc.containsKey("clearSky")) {
    JsonArray clearSky = doc["clearSky"];
    customQuotes.clearSkyCount = min((size_t)MAX_QUOTES_PER_CATEGORY, clearSky.size());
    for (int i = 0; i < customQuotes.clearSkyCount; i++) {
      customQuotes.clearSky[i] = clearSky[i].as<String>();
    }
  }
  
  if (doc.containsKey("brokenClouds")) {
    JsonArray brokenClouds = doc["brokenClouds"];
    customQuotes.brokenCloudsCount = min((size_t)MAX_QUOTES_PER_CATEGORY, brokenClouds.size());
    for (int i = 0; i < customQuotes.brokenCloudsCount; i++) {
      customQuotes.brokenClouds[i] = brokenClouds[i].as<String>();
    }
  }
  
  quotesFile.close();
  Serial.println(F("Citazioni caricate con successo"));
}

// Funzione per ottenere una citazione in base alla categoria meteo
String getWeatherQuote(String weatherCategory) {
  // Implementazione ottimizzata per risparmiare memoria
  int quoteIndex = random(0, MAX_QUOTES_PER_CATEGORY);
  
  if (weatherCategory == "Thunderstorm" && customQuotes.thunderstormCount > 0) {
    return customQuotes.thunderstorm[quoteIndex % customQuotes.thunderstormCount];
  } 
  else if (weatherCategory == "Drizzle" && customQuotes.drizzleCount > 0) {
    return customQuotes.drizzle[quoteIndex % customQuotes.drizzleCount];
  } 
  else if (weatherCategory == "Rain" && customQuotes.rainCount > 0) {
    return customQuotes.rain[quoteIndex % customQuotes.rainCount];
  } 
  else if (weatherCategory == "Snow" && customQuotes.snowCount > 0) {
    return customQuotes.snow[quoteIndex % customQuotes.snowCount];
  } 
  else if (weatherCategory == "Clear" && customQuotes.clearSkyCount > 0) {
    return customQuotes.clearSky[quoteIndex % customQuotes.clearSkyCount];
  } 
  else if (weatherCategory == "Clouds" && customQuotes.brokenCloudsCount > 0) {
    return customQuotes.brokenClouds[quoteIndex % customQuotes.brokenCloudsCount];
  }
  
  // Citazione predefinita se nessuna categoria corrisponde o nessuna citazione disponibile
  return F("Il clima cambia, ma la nostra connessione con la natura rimane.");
}


// Funzione loop ottimizzata
void loop() {
  // Gestisci le richieste del server web
  server.handleClient();

  // Gestione DNS Server in modalità AP
  if (inAPMode) {
    dnsServer.processNextRequest();
  }

  // Aggiorna il display con i dati meteo ogni 10 minuti
  static unsigned long lastUpdate = 0;
  unsigned long now = millis();
  if (!inAPMode && WiFi.status() == WL_CONNECTED && now - lastUpdate >= 600000) {  // 10 minuti
    updateWeather();
    updateEinkDisplay();
    lastUpdate = now;
  }
}