    .quote-card {
      background: var(--card-bg);
      border-radius: var(--border-radius);
      padding: 24px;
      box-shadow: var(--card-shadow);
      position: relative;
      margin-bottom: 20px;
    }
    
    .quote-content {
      font-size: 18px;
