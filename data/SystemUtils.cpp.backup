// Generazione del JavaScript per la pagina delle impostazioni
String generateSettingsJS() {
  String js = R"(
    // Gestione della visualizzazione password
    document.querySelectorAll('.toggle-password').forEach(button => {
      button.addEventListener('click', function() {
        const input = this.previousElementSibling;
        const icon = this.querySelector('i');
        
        if (input.type === 'password') {
          input.type = 'text';
          icon.classList.remove('fa-eye');
          icon.classList.add('fa-eye-slash');
        } else {
          input.type = 'password';
          icon.classList.remove('fa-eye-slash');
          icon.classList.add('fa-eye');
        }
      });
    });
    
    // Funzione per aggiornare lo stato della scansione
    function updateScanStatus(message, isError = false) {
      const statusElement = document.getElementById('scan-status');
      statusElement.innerHTML = message;
      statusElement.style.color = isError ? '#ff3860' : '#666';
    }
    
    // Funzione per scansionare le reti WiFi
    function scanWiFi() {
      const scanBtn = document.getElementById('scan-wifi-btn');
      const ssidSelect = document.getElementById('ssid');
      const currentSsid = ssidSelect.value;
      
      scanBtn.disabled = true;
      scanBtn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Scansione...';
      updateScanStatus('Scansione reti in corso...');
      
      fetch('/api/wifi/scan')
        .then(response => {
          if (!response.ok) {
            throw new Error('Errore nella scansione: ' + response.status);
          }
          return response.json();
        })
        .then(networks => {
          // Pulisce il dropdown mantenendo solo la prima opzione
          while (ssidSelect.options.length > 1) {
            ssidSelect.remove(1);
          }
          
          // Controllo se ci sono reti trovate
          if (networks.length === 0) {
            updateScanStatus('Nessuna rete trovata.', true);
            return;
          }
          
          // Ordina le reti per potenza del segnale (RSSI)
          networks.sort((a, b) => b.rssi - a.rssi);
          
          // Aggiunge le reti al dropdown
          networks.forEach(network => {
            const option = document.createElement('option');
            option.value = network.ssid;
            
            // Calcola la potenza del segnale in percentuale
            const signalStrength = Math.min(100, Math.max(0, (network.rssi + 100) * 2));
            
            // Crea il testo dell'opzione con informazioni sul segnale
            let securityIcon = network.secure ? '&#128274;' : '&#128275;';
            option.text = `${network.ssid} (${signalStrength.toFixed(0)}%, Ch${network.channel}, ${network.encryption}) ${securityIcon}`;
            
            // Se è la rete attualmente configurata, selezionala
            if (network.ssid === currentSsid) {
              option.selected = true;
            }
            
            ssidSelect.add(option);
          });
          
          updateScanStatus(`Trovate ${networks.length} reti.`);
        })
        .catch(error => {
          updateScanStatus(`Errore: ${error.message}`, true);
        })
        .finally(() => {
          scanBtn.disabled = false;
          scanBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Scansiona';
        });
    }
    
    // Funzione per salvare le impostazioni
    function saveSettings(event) {
      event.preventDefault();
      
      const form = document.getElementById('wifi-form');
      const formData = new FormData(form);
      const jsonData = {};
      
      formData.forEach((value, key) => {
        if (key === 'daylight_saving') {
          jsonData[key] = true; // Se presente nel form, è checked
        } else {
          jsonData[key] = value;
        }
      });
      
      // Se daylight_saving non è nel form, lo imposta a false
      if (!formData.has('daylight_saving')) {
        jsonData['daylight_saving'] = false;
      }
      
      fetch('/api/settings', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(jsonData)
      })
      .then(response => {
        if (!response.ok) {
          throw new Error('Errore nel salvataggio');
        }
        return response.json();
      })
      .then(data => {
        if (data.success) {
          // Mostra messaggio di successo
          const statusElement = document.createElement('div');
          statusElement.className = 'status-message success';
          statusElement.innerHTML = '<p>Impostazioni salvate con successo!</p>';
          
          const main = document.querySelector('main');
          main.insertBefore(statusElement, main.firstChild);
          
          // Rimuovi il messaggio dopo 5 secondi
          setTimeout(() => {
            statusElement.style.opacity = '0';
            setTimeout(() => statusElement.remove(), 500);
          }, 5000);
        } else {
          throw new Error(data.message || 'Errore nel salvataggio');
        }
      })
      .catch(error => {
        // Mostra messaggio di errore
        const statusElement = document.createElement('div');
        statusElement.className = 'status-message error';
        statusElement.innerHTML = `<p>${error.message}</p>`;
        
        const main = document.querySelector('main');
        main.insertBefore(statusElement, main.firstChild);
        
        // Rimuovi il messaggio dopo 5 secondi
        setTimeout(() => {
          statusElement.style.opacity = '0';
          setTimeout(() => statusElement.remove(), 500);
        }, 5000);
      });
    }
    
    // Funzione per riavviare il dispositivo
    function restartDevice() {
      if (confirm('Sei sicuro di voler riavviare il dispositivo?')) {
        fetch('/api/restart', { method: 'POST' })
          .then(response => {
            if (!response.ok) {
              throw new Error('Errore nel riavvio');
            }
            
            // Mostra messaggio di riavvio
            const statusElement = document.createElement('div');
            statusElement.className = 'status-message info';
            statusElement.innerHTML = '<p>Riavvio in corso...</p>';
            
            const main = document.querySelector('main');
            main.insertBefore(statusElement, main.firstChild);
            
            // Aggiorna la pagina dopo 15 secondi
            setTimeout(() => {
              window.location.reload();
            }, 15000);
          })
          .catch(error => {
            // Mostra messaggio di errore
            const statusElement = document.createElement('div');
            statusElement.className = 'status-message error';
            statusElement.innerHTML = `<p>${error.message}</p>`;
            
            const main = document.querySelector('main');
            main.insertBefore(statusElement, main.firstChild);
            
            // Rimuovi il messaggio dopo 5 secondi
            setTimeout(() => {
              statusElement.style.opacity = '0';
              setTimeout(() => statusElement.remove(), 500);
            }, 5000);
          });
      }
    }
    
    // Funzione per caricare le impostazioni e inizializzare la pagina
    function loadSettings() {
      // Aggiungi gli event listener
      document.getElementById('wifi-form').addEventListener('submit', saveSettings);
      document.getElementById('restart-btn').addEventListener('click', restartDevice);
      document.getElementById('scan-wifi-btn').addEventListener('click', scanWiFi);
      
      // Se siamo in modalità AP, esegui immediatamente una scansione WiFi
      if (document.getElementById('wifi-form-container').classList.contains('ap-mode-highlight')) {
        // Scorri fino alla sezione WiFi
        document.getElementById('wifi-settings').scrollIntoView({ behavior: 'smooth' });
        
        // Avvia la scansione dopo un breve ritardo
        setTimeout(scanWiFi, 500);
      }
    }
    
    // Inizializza al caricamento della pagina
    document.addEventListener('DOMContentLoaded', loadSettings);
  )";
  return js;
}

// Generazione del JavaScript per la pagina di scansione WiFi
String generateWiFiScanJS() {
  String js = R"(
    document.addEventListener('DOMContentLoaded', () => {
      const scanBtn = document.getElementById('scan-btn');
      const statusElement = document.getElementById('scan-status');
      const networksList = document.getElementById('networks-list');
      const networkSelect = document.getElementById('network-select');
      const networkSelectContainer = networkSelect.parentNode;
      
      // Funzione per convertire RSSI in percentuale
      function rssiToPercentage(rssi) {
        // RSSI tipicamente varia da -100 dBm (debole) a -30 dBm (forte)
        if (rssi >= -50) {
          return 100;
        } else if (rssi <= -100) {
          return 0;
        } else {
          // Conversione lineare tra -100 e -50
          return 2 * (rssi + 100);
        }
      }
      
      // Funzione per creare una barra del segnale visiva
      function createSignalBar(percentage) {
        return `
          <div class="signal-bar">
            <div class="signal-fill" style="width: ${percentage}%"></div>
          </div>
          <div>${percentage.toFixed(0)}%</div>
        `;
      }
      
      // Funzione per scansionare le reti WiFi
      function scanNetworks() {
        scanBtn.disabled = true;
        scanBtn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Scansione in corso...';
        statusElement.innerHTML = 'Scansione reti in corso...';
        networksList.innerHTML = '';
        networkSelectContainer.style.display = 'none';
        
        // Svuota il dropdown
        while (networkSelect.options.length > 1) {
          networkSelect.remove(1);
        }
        
        fetch('/api/wifi/scan')
          .then(response => {
            if (!response.ok) {
              throw new Error('Errore nella scansione: ' + response.status);
            }
            return response.json();
          })
          .then(networks => {
            if (networks.length === 0) {
              statusElement.innerHTML = 'Nessuna rete trovata.';
              return;
            }
            
            // Ordina le reti per potenza del segnale
            networks.sort((a, b) => b.rssi - a.rssi);
            
            // Popola il dropdown e la lista visuale
            networks.forEach(network => {
              // Aggiunge al dropdown
              const option = document.createElement('option');
              option.value = network.ssid;
              option.text = network.ssid;
              networkSelect.add(option);
              
              // Calcola percentuale segnale
              const signalPercentage = rssiToPercentage(network.rssi);
              
              // Crea card per la rete
              const networkCard = document.createElement('div');
              networkCard.className = 'card';
              networkCard.style.marginBottom = '10px';
              networkCard.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <div style="flex-grow: 1;">
                    <h3 style="margin-bottom: 5px;">${network.ssid}</h3>
                    <div style="display: flex; align-items: center; margin-bottom: 10px;">
                      <div style="margin-right: 10px; width: 120px;">
                        ${createSignalBar(signalPercentage)}
                      </div>
                      <div>
                        <span style="font-size: 0.9em; color: #666;">
                          CH: ${network.channel} | ${network.encryption}
                        </span>
                      </div>
                    </div>
                  </div>
                  <div>
                    ${network.secure ? 
                      '<i class="fas fa-lock" style="font-size: 1.5em; color: #f59f00;"></i>' : 
                      '<i class="fas fa-lock-open" style="font-size: 1.5em; color: #0ca678;"></i>'}
                  </div>
                </div>
                <div style="text-align: right;">
                  <button class="btn secondary select-network" data-ssid="${network.ssid}">
                    Seleziona
                  </button>
                </div>
              `;
              
              networksList.appendChild(networkCard);
            });
            
            // Mostra il dropdown
            networkSelectContainer.style.display = 'block';
            
            // Aggiunge event listener ai pulsanti "Seleziona"
            document.querySelectorAll('.select-network').forEach(button => {
              button.addEventListener('click', function() {
                const ssid = this.getAttribute('data-ssid');
                // Reindirizza alla pagina delle impostazioni con il SSID preselezionato
                window.location.href = `/settings.html?ssid=${encodeURIComponent(ssid)}`;
              });
            });
            
            statusElement.innerHTML = `Trovate ${networks.length} reti.`;
          })
          .catch(error => {
            statusElement.innerHTML = `Errore: ${error.message}`;
          })
          .finally(() => {
            scanBtn.disabled = false;
            scanBtn.innerHTML = '<i class="fas fa-sync-alt"></i> Scansiona Reti';
          });
      }
      
      // Aggiungi event listener al pulsante di scansione
      scanBtn.addEventListener('click', scanNetworks);
      
      // Avvia una scansione automatica all'apertura della pagina
      scanNetworks();
    });
  )";
  return js;
}

// Serve le icone meteo
void serveWeatherIcon(WiFiClient& client, const String& path) {
  // Estrai il nome del file dalla path
  String iconName = path.substring(path.lastIndexOf('/') + 1);
  
  // Verifica se il file esiste nella SPIFFS
  if (!SPIFFS.exists("/icons/" + iconName)) {
    sendResponse(client, "text/plain", "404 - Icona non trovata", 404);
    return;
  }
  
  // Apri il file e invia il contenuto al client
  File iconFile = SPIFFS.open("/icons/" + iconName, "r");
  if (!iconFile) {
    sendResponse(client, "text/plain", "500 - Errore lettura icona", 500);
    return;
  }
  
  // Invia l'icona con le intestazioni corrette
  String contentType = "image/svg+xml";
  if (iconName.endsWith(".png")) {
    contentType = "image/png";
  }
  
  // Intestazioni HTTP
  client.println("HTTP/1.1 200 OK");
  client.println("Content-Type: " + contentType);
  client.println("Connection: close");
  client.println();
  
  // Invia il contenuto del file
  while (iconFile.available()) {
    client.write(iconFile.read());
  }
  
  // Chiudi il file
  iconFile.close();
}

// Serve il QR code
void serveQRCode(WiFiClient& client) {
  // Invece di leggere un file, genera direttamente la risposta con il QR code SVG
  client.println("HTTP/1.1 200 OK");
  client.println("Content-Type: image/svg+xml");
  client.println("Connection: close");
  client.println();
  
  // QR code SVG basato sull'immagine fornita dall'utente
  client.println("<?xml version=\"1.0\" encoding=\"UTF-8\"?>");
  client.println("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 300 350\">");
  
  // Balloon "SCAN ME" in alto
  client.println("  <rect x=\"0\" y=\"0\" width=\"300\" height=\"50\" rx=\"10\" ry=\"10\" fill=\"black\"/>");
  client.println("  <text x=\"150\" y=\"35\" font-family=\"Arial\" font-size=\"30\" font-weight=\"bold\" fill=\"white\" text-anchor=\"middle\">SCAN ME</text>");
  
  // Triangolo che collega il balloon al QR code
  client.println("  <path d=\"M 150 50 L 170 70 L 130 70 Z\" fill=\"black\"/>");
  
  // Bordo esterno del QR code
  client.println("  <rect x=\"20\" y=\"70\" width=\"260\" height=\"260\" stroke=\"black\" stroke-width=\"6\" fill=\"white\"/>");
  
  // Angoli di posizionamento del QR code
  // Top-left
  client.println("  <rect x=\"40\" y=\"90\" width=\"60\" height=\"60\" fill=\"black\"/>");
  client.println("  <rect x=\"50\" y=\"100\" width=\"40\" height=\"40\" fill=\"white\"/>");
  client.println("  <rect x=\"60\" y=\"110\" width=\"20\" height=\"20\" fill=\"black\"/>");
  
  // Top-right
  client.println("  <rect x=\"200\" y=\"90\" width=\"60\" height=\"60\" fill=\"black\"/>");
  client.println("  <rect x=\"210\" y=\"100\" width=\"40\" height=\"40\" fill=\"white\"/>");
  client.println("  <rect x=\"220\" y=\"110\" width=\"20\" height=\"20\" fill=\"black\"/>");
  
  // Bottom-left
  client.println("  <rect x=\"40\" y=\"250\" width=\"60\" height=\"60\" fill=\"black\"/>");
  client.println("  <rect x=\"50\" y=\"260\" width=\"40\" height=\"40\" fill=\"white\"/>");
  client.println("  <rect x=\"60\" y=\"270\" width=\"20\" height=\"20\" fill=\"black\"/>");
  
  // Pattern interni del QR code (generati parzialmente in modo casuale)
  for (int i = 0; i < 10; i++) {
    for (int j = 0; j < 10; j++) {
      // Evita di sovrascrivere i marker angolari
      bool isCorner = (i < 2 && j < 2) || (i < 2 && j > 7) || (i > 7 && j < 2);
      if (!isCorner && (i + j) % 3 == 0) {
        client.printf("  <rect x=\"%d\" y=\"%d\" width=\"15\" height=\"15\" fill=\"black\"/>\n", 
                     40 + i * 22, 90 + j * 22);
      }
    }
  }
  
  // Altri pattern per rendere più realistico il QR code
  client.println("  <rect x=\"110\" y=\"110\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"140\" y=\"170\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"175\" y=\"200\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"90\" y=\"230\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"120\" y=\"260\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"195\" y=\"140\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"220\" y=\"220\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"150\" y=\"90\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"180\" y=\"120\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"90\" y=\"160\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"60\" y=\"195\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"155\" y=\"240\" width=\"15\" height=\"15\" fill=\"black\"/>");
  client.println("  <rect x=\"170\" y=\"290\" width=\"15\" height=\"15\" fill=\"black\"/>");
  
  client.println("</svg>");
}

// ----------- FUNZIONI CONFIGURAZIONE -----------

// Funzioni esterne dichiarate in Config.h, implementate in Config.cpp
extern bool loadConfig();
extern bool saveConfig();

// ----------- FUNZIONE PRINCIPALE -----------

// Implementazione della funzione setup() del modulo
bool systemSetup() {
  Serial.println("\n\n==== AtmoVerse 2.0 ====");
  Serial.println("Avvio sistema...");
  
  // Inizializza la memoria SPIFFS
  if (!SPIFFS.begin(true)) {
    Serial.println("Errore nell'inizializzazione SPIFFS");
    return false;
  }
  Serial.println("SPIFFS inizializzato");
  
  // Carica la configurazione
  if (!loadConfig()) {
    Serial.println("Utilizzo valori di default per la configurazione");
    
    // Imposta valori di default in caso di errore
    strcpy(config.ssid, "");
    strcpy(config.password, "");
    strcpy(config.city, "Roma");
    strcpy(config.api_key, "");
    strcpy(config.ntpServer, "pool.ntp.org");
    config.gmtOffset_sec = 3600;
    config.daylightOffset_sec = 0;
  }
  
  // Inizializza il WiFi
  return setupWiFi();
}

// Prototipi delle funzioni
void systemLoop();
void updateWeatherData();
void updateTime();
void updateSystemStatus();
int calculateSignalQuality(int rssi);

void systemLoop() {
  // Gestisce le richieste web
  handleClientRequests();
  
  // Aggiorna i dati meteo ogni intervalloAggiornamento secondi
  static unsigned long ultimoAggiornamento = 0;
  unsigned long ora = millis();
  const unsigned long intervalloAggiornamento = 10 * 60 * 1000; // 10 minuti
  
  if (ora - ultimoAggiornamento >= intervalloAggiornamento || ultimoAggiornamento == 0) {
    ultimoAggiornamento = ora;
    
    // Se non siamo in AP mode e abbiamo una connessione WiFi
    if (!apMode && WiFi.status() == WL_CONNECTED) {
      // Aggiorna i dati meteo
      updateWeatherData();
      
      // Sincronizza l'ora con NTP
      updateTime();
    }
  }
  
  // Aggiorna lo stato del sistema (memoria, uptime, ecc.)
  static unsigned long ultimoAggiornamentoStato = 0;
  const unsigned long intervalloAggiornamentoStato = 5000; // 5 secondi
  
  if (ora - ultimoAggiornamentoStato >= intervalloAggiornamentoStato) {
    ultimoAggiornamentoStato = ora;
    updateSystemStatus();
  }
}

void updateWeatherData() {
  Serial.println("Aggiornamento dati meteo...");
  
  HTTPClient http;
  String url = "http://api.openweathermap.org/data/2.5/weather?q=" + 
               String(config.city) + 
               "&units=metric&lang=it&appid=" + 
               String(config.api_key);
  
  http.begin(url);
  int httpCode = http.GET();
  
  if (httpCode == HTTP_CODE_OK) {
    String payload = http.getString();
    Serial.println("Dati meteo ricevuti");
    currentWeather.last_update = time(nullptr);
    
    // Parsing del json
    bool success = parseWeatherData(payload);
    http.end();
    weatherDataUpdated = success; // Invece di return success
  } else {
    Serial.print("Errore nel download dei dati meteo: ");
    Serial.println(httpCode);
    http.end();
    weatherDataUpdated = false; // Invece di return false
  }
}

void updateTime() {
  if (WiFi.status() == WL_CONNECTED) {
    // Ottieni l'ora corrente
    struct tm timeinfo;
    if (!getLocalTime(&timeinfo)) {
      Serial.println("Errore nell'ottenere l'ora locale");
      return;
    }
    
    // Utilizziamo le variabili globali dichiarate altrove
    // Log per debug
    char timeString[30];
    strftime(timeString, sizeof(timeString), "%d/%m/%Y %H:%M:%S", &timeinfo);
    Serial.print("Ora aggiornata: ");
    Serial.println(timeString);
  }
}

void updateSystemStatus() {
  // Aggiorna i dati di uptime
  systemStatus.uptime = millis() / 1000; // Converti in secondi
  
  // Aggiorna i dati di utilizzo memoria
  systemStatus.freeMemory = ESP.getFreeHeap();
  systemStatus.totalMemory = ESP.getHeapSize();
  systemStatus.memoryUsagePercent = 100.0 - ((float)systemStatus.freeMemory / systemStatus.totalMemory * 100.0);
  
  // Aggiorna i dati WiFi
  if (WiFi.status() == WL_CONNECTED) {
    systemStatus.wifiRSSI = WiFi.RSSI();
    systemStatus.wifiQuality = calculateSignalQuality(systemStatus.wifiRSSI);
  } else {
    systemStatus.wifiRSSI = -100; // Valore molto basso
    systemStatus.wifiQuality = 0;
  }
}

int calculateSignalQuality(int rssi) {
  // Converte il valore RSSI in una percentuale di qualità
  // RSSI tipicamente varia da -100 dBm (segnale molto debole) a -30 dBm (segnale molto forte)
  if (rssi <= -100) {
    return 0;
  } else if (rssi >= -50) {
    return 100;
  } else {
    // Interpolazione lineare tra -100 e -50
    return 2 * (rssi + 100);
  }
}

void checkWiFiConnection() {
  static unsigned long lastCheck = 0;
  unsigned long currentMillis = millis();
  if ((unsigned long)(currentMillis - lastCheck) >= WIFI_CHECK_INTERVAL) {
    lastCheck = currentMillis;
    if (WiFi.status() != WL_CONNECTED && !apMode) {
      Serial.println("WiFi connection lost, attempting to reconnect...");
      reconnectToWiFi();
    }
  }
}

// Serve le icone meteo
void serveWeatherIcon(WiFiClient& client, const String& path) {
  // Estrai il nome del file dalla path
  String iconName = path.substring(path.lastIndexOf('/') + 1);
  
  // Verifica se il file esiste nella SPIFFS
  if (!SPIFFS.exists("/icons/" + iconName)) {
    sendResponse(client, "text/plain", "404 - Icona non trovata", 404);
    return;
  }
  
  // Apri il file e invia il contenuto al client
  File iconFile = SPIFFS.open("/icons/" + iconName, "r");
  if (!iconFile) {
    sendResponse(client, "text/plain", "500 - Errore lettura icona", 500);
    return;
  }
  
  // Invia l'icona con le intestazioni corrette
  String contentType = "image/svg+xml";
  if (iconName.endsWith(".png")) {
    contentType = "image/png";
  }
  
  // Intestazioni HTTP
  client.println("HTTP/1.1 200 OK");
  client.println("Content-Type: " + contentType);
  client.println("Connection: close");
  client.println();
  
  // Invia il contenuto del file
  while (iconFile.available()) {
    client.write(iconFile.read());
  }
  
  // Chiudi il file
  iconFile.close();
}

