// Connessione al WiFi
bool connectToWiFi() {
  Serial.print("Connessione al WiFi ");
  Serial.print(config.ssid);
  Serial.println("...");
  
  WiFi.mode(WIFI_STA);
  WiFi.begin(config.ssid, config.password);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 20) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("");
    Serial.println("WiFi connesso!");
    Serial.print("Indirizzo IP: ");
    Serial.println(WiFi.localIP());
    
    apMode = false;
    
    return true;
  } else {
    Serial.println("");
    Serial.println("Connessione WiFi fallita!");
    return false;
  }
}

// Setup del WiFi
bool setupWiFi() {
  Serial.println("Configurazione WiFi...");
  
  if (strlen(config.ssid) > 0) {
    if (connectToWiFi()) {
      // Configura server NTP
      setupTimeServer();
      
      // Inizializza server web
      Serial.println("Inizializzazione server web...");
      setupServer();
      
      // Scarica dati meteo
      if (getWeatherData()) {
        Serial.println("Dati meteo scaricati con successo");
      } else {
        Serial.println("Errore nel download dei dati meteo");
      }
      
      return true;
    }
  }
  
  // Se la connessione fallisce, diventa un access point
  Serial.println("Avvio modalità Access Point...");
  startAccessPoint();
  return false;
}

// Funzione per avviare la modalità access point
void startAccessPoint() {
  Serial.println("Avvio modalità Access Point...");
  
  WiFi.mode(WIFI_AP);
  WiFi.softAP("AtmoVerse_AP", "atmoverse");
  
  Serial.print("Access Point avviato con IP: ");
  Serial.println(WiFi.softAPIP());
  
  // Imposta modalità AP
  apMode = true;
  
  // Avvia il DNS server per catturare tutte le richieste
  dnsServer.start(53, "*", WiFi.softAPIP());
  
  // Configura e avvia il server web
  setupServer();
}

// Sincronizzazione con il server NTP
void setupTimeServer() {
  Serial.println("Configurazione server NTP...");
  
  // Configura server NTP
  configTime(config.gmtOffset_sec, config.daylightOffset_sec, config.ntpServer);
  
  time_t now;
  struct tm timeinfo;
  if (getLocalTime(&timeinfo)) {
    time(&now);
    Serial.print("Data e ora impostate: ");
    Serial.println(ctime(&now));
  } else {
    Serial.println("Errore nella sincronizzazione NTP");
  }
}

// Verifica connessione e riconnette se necessario
bool reconnectIfNeeded() {
  if (WiFi.status() != WL_CONNECTED && !apMode) {
    Serial.println("Connessione WiFi persa. Tentativo di riconnessione...");
    return reconnectToWiFi();
  }
  return true;
}

// Riconnessione al WiFi
bool reconnectToWiFi() {
  Serial.println("Tentativo di riconnessione...");
  
  // Reset del WiFi
  WiFi.disconnect();
  delay(1000);
  
  // Tentativo di riconnessione
  WiFi.begin(config.ssid, config.password);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 10) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("");
    Serial.println("WiFi riconnesso!");
    Serial.print("Indirizzo IP: ");
    Serial.println(WiFi.localIP());
    
    // Reinizializza server
    if (!apMode) {
      setupServer();
      // Aggiorna dati meteo dopo riconnessione
      getWeatherData();
    } else {
      // Se eravamo in modalità AP, ma ora siamo connessi, riconfigura il server
      setupServer();
    }
    
    return true;
  } else {
    Serial.println("");
    Serial.println("Riconnessione fallita!");
    
    // Se la riconnessione fallisce più volte, passa in modalità AP
    startAccessPoint();
    return false;
  }
}

// Funzione migliorata per scansionare le reti WiFi disponibili
String scanWiFiNetworks() {
  Serial.println("Scansione reti WiFi...");
  
  String jsonResult = "[";
  int networksFound = WiFi.scanNetworks();
  
  Serial.print("Reti trovate: ");
  Serial.println(networksFound);
  
  for (int i = 0; i < networksFound; i++) {
    // Ottiene i dati della rete
    String ssid = WiFi.SSID(i);
    int32_t rssi = WiFi.RSSI(i);
    uint8_t encType = WiFi.encryptionType(i);
    int32_t channel = WiFi.channel(i);
    bool isHidden = false; // Assuming all networks are visible by default
    
    // Determina il tipo di crittografia
    String encryption = "";
    switch (encType) {
      case WIFI_AUTH_OPEN: encryption = "Open"; break;
      case WIFI_AUTH_WEP: encryption = "WEP"; break;
      case WIFI_AUTH_WPA_PSK: encryption = "WPA-PSK"; break;
      case WIFI_AUTH_WPA2_PSK: encryption = "WPA2-PSK"; break;
      case WIFI_AUTH_WPA_WPA2_PSK: encryption = "WPA/WPA2-PSK"; break;
      case WIFI_AUTH_WPA2_ENTERPRISE: encryption = "WPA2-Enterprise"; break;
      case WIFI_AUTH_WPA3_PSK: encryption = "WPA3-PSK"; break;
      case WIFI_AUTH_WPA2_WPA3_PSK: encryption = "WPA2/WPA3-PSK"; break;
      default: encryption = "Unknown"; break;
    }
    
    // Se la rete è nascosta, usa un nome temporaneo
    if (isHidden) {
      ssid = "<Rete nascosta>";
    }
    
    // Aggiunge la rete al JSON
    jsonResult += "{";
    jsonResult += "\"ssid\":\"" + ssid + "\",";
    jsonResult += "\"rssi\":" + String(rssi) + ",";
    jsonResult += "\"secure\":" + String(encType != WIFI_AUTH_OPEN) + ",";
    jsonResult += "\"channel\":" + String(channel) + ",";
    jsonResult += "\"encryption\":\"" + encryption + "\"";
    jsonResult += "}";
    
    // Aggiunge la virgola se non è l'ultima rete
    if (i < networksFound - 1) {
      jsonResult += ",";
    }
  }
  
  // Chiude il JSON array
  jsonResult += "]";
  
  // Rilascia la memoria usata per la scansione
  WiFi.scanDelete();
  
  return jsonResult;
}

// Funzione per ottenere i dati meteo
bool getWeatherData() {
  if (apMode || strlen(config.api_key) == 0 || strlen(config.city) == 0) {
    Serial.println("Impossibile ottenere dati meteo: in modalità AP o dati API mancanti");
    return false;
  }
  
  Serial.println("Download dati meteo...");
  
  HTTPClient http;
  String url = "http://api.openweathermap.org/data/2.5/weather?q=" + 
               String(config.city) + 
               "&units=metric&lang=it&appid=" + 
               String(config.api_key);
  
  http.begin(url);
  int httpCode = http.GET();
  
  if (httpCode == HTTP_CODE_OK) {
    String payload = http.getString();
    Serial.println("Dati meteo ricevuti");
    currentWeather.last_update = time(nullptr);
    
    // Parsing del json
    bool success = parseWeatherData(payload);
    http.end();
    return success;
  } else {
    Serial.print("Errore nel download dei dati meteo: ");
    Serial.println(httpCode);
    http.end();
    return false;
  }
}

// Parsing dei dati meteo JSON
bool parseWeatherData(String& payload) {
  DynamicJsonDocument doc(1024);
  DeserializationError error = deserializeJson(doc, payload);
  
  if (error) {
    Serial.print("Errore parsing JSON: ");
    Serial.println(error.c_str());
    currentWeather.valid = false;
    return false;
  }
  
  currentWeather.temp = doc["main"]["temp"];
  currentWeather.feels_like = doc["main"]["feels_like"];
  currentWeather.humidity = doc["main"]["humidity"];
  currentWeather.pressure = doc["main"]["pressure"];
  currentWeather.wind_speed = doc["wind"]["speed"];
  currentWeather.wind_deg = doc["wind"]["deg"];
  
  String desc = doc["weather"][0]["description"];
  strncpy(currentWeather.description, desc.c_str(), sizeof(currentWeather.description) - 1);
  currentWeather.description[sizeof(currentWeather.description) - 1] = 0; // Null termination
  
  String icon = doc["weather"][0]["icon"];
  strncpy(currentWeather.icon, icon.c_str(), sizeof(currentWeather.icon) - 1);
  currentWeather.icon[sizeof(currentWeather.icon) - 1] = 0; // Null termination
  
  currentWeather.weather_id = doc["weather"][0]["id"];
  currentWeather.valid = true;
  
  return true;
}

// Verifica validità dei dati meteo
bool isWeatherDataValid() {
  return currentWeather.valid;
}

// Verifica se è notte
bool isNightTime() {
  return (currentWeather.valid && strchr(currentWeather.icon, 'n') != NULL);
}

// Ottiene il timestamp dell'ultimo aggiornamento meteo
time_t getLastUpdateTime() {
  return currentWeather.last_update;
}

