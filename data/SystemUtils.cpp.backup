// ----------- FUNZIONI SERVER WEB -----------

// Configurazione delle route del server web
void setupServer() {
  // Inizializza il server web sulla porta 80
  server = WiFiServer(80);
  server.begin();
  
  Serial.println("Server web inizializzato");
}

// Funzione di gestione richieste web
void handleClientRequests() {
  if (apMode) {
    // In modalità AP, gestisce le richieste DNS per il captive portal
    dnsServer.processNextRequest();
  }
  
  // Controlla se ci sono client connessi
  WiFiClient client = server.available();
  if (!client) {
    return;
  }
  
  Serial.println("Nuovo client connesso");
  
  // Timeout di lettura dei dati dalla request
  unsigned long timeout = millis();
  while (client.connected() && millis() - timeout < 1000) {
    if (client.available()) {
      // Legge la prima riga della richiesta
      String request = client.readStringUntil('\r');
      client.readStringUntil('\n');
      Serial.println("Richiesta: " + request);
      
      // Estrae il metodo e il percorso
      int firstSpace = request.indexOf(' ');
      int secondSpace = request.indexOf(' ', firstSpace + 1);
      
      String method = request.substring(0, firstSpace);
      String path = request.substring(firstSpace + 1, secondSpace);
      
      Serial.print("Metodo: ");
      Serial.println(method);
      Serial.print("Percorso: ");
      Serial.println(path);
      
      // Legge le intestazioni fino alla riga vuota
      while (client.available()) {
        String line = client.readStringUntil('\r');
        client.readStringUntil('\n');
        if (line.length() == 0) {
          break;
        }
      }
      
      // Legge il corpo della richiesta se presente (per richieste POST)
      String body = "";
      if (method == "POST") {
        while (client.available()) {
          body += (char)client.read();
        }
        Serial.print("Corpo: ");
        Serial.println(body);
      }
      
      // Routing delle richieste
      if (path == "/" || path == "/index.html") {
        // Pagina principale
        sendResponse(client, "text/html", generateMainPage());
      } else if (path == "/settings.html") {
        // Pagina impostazioni
        sendResponse(client, "text/html", generateSettingsPage());
      } else if (path == "/wifi.html") {
        // Pagina scansione WiFi
        sendResponse(client, "text/html", generateWiFiScanPage());
      } else if (path == "/api/wifi/scan") {
        // API per la scansione delle reti WiFi
        performWiFiScan(client);
      } else if (path == "/api/settings" && method == "POST") {
        // API per salvare le impostazioni
        saveSettings(client, body);
      } else if (path == "/api/restart" && method == "POST") {
        // API per riavviare il dispositivo
        restartDevice(client);
      } else if (path.startsWith("/icons/")) {
        // Serve le icone meteo
        serveWeatherIcon(client, path);
      } else if (path == "/qrcode.svg") {
        // Serve il QR code
        serveQRCode(client);
      } else {
        // In modalità AP, redireziona tutte le richieste non riconosciute alla pagina principale
        if (apMode) {
          sendResponse(client, "text/html", generateMainPage());
        } else {
          // In modalità normale, invia 404
          sendResponse(client, "text/plain", "404 - Not Found", 404);
        }
      }
      
      break;
    }
  }
  
  // Chiude la connessione
  client.stop();
  Serial.println("Client disconnesso");
}

// Invia una risposta HTTP al client
void sendResponse(WiFiClient& client, const String& contentType, const String& content, int statusCode) {
  // Prepara lo stato HTTP appropriato
  String status = "200 OK";
  if (statusCode == 404) {
    status = "404 Not Found";
  } else if (statusCode == 500) {
    status = "500 Internal Server Error";
  }
  
  // Invia intestazioni
  client.print("HTTP/1.1 ");
  client.println(status);
  client.println("Content-Type: " + contentType);
  client.print("Content-Length: ");
  client.println(content.length());
  client.println("Connection: close");
  
  // Se siamo in modalità AP, aggiungi intestazioni per impedire caching
  if (apMode) {
    client.println("Cache-Control: no-cache, no-store, must-revalidate");
    client.println("Pragma: no-cache");
    client.println("Expires: 0");
  }
  
  // Linea vuota che separa intestazioni e contenuto
  client.println();
  
  // Invia il contenuto
  client.println(content);
}

// API per la scansione delle reti WiFi
void performWiFiScan(WiFiClient& client) {
  // Effettua la scansione
  String networksJson = scanWiFiNetworks();
  
  // Invia i risultati come JSON
  sendResponse(client, "application/json", networksJson);
}

// API per salvare le impostazioni
void saveSettings(WiFiClient& client, const String& jsonBody) {
  Serial.println("Salvataggio impostazioni...");
  
  // Parsa il JSON
  DynamicJsonDocument doc(1024);
  DeserializationError error = deserializeJson(doc, jsonBody);
  
  // Se c'è un errore nel parsing, restituisci errore
  if (error) {
    Serial.print("Errore nel parsing del JSON: ");
    Serial.println(error.c_str());
    sendResponse(client, "application/json", "{\"success\":false,\"message\":\"Errore nel parsing del JSON\"}", 500);
    return;
  }
  
  // Flag per tenere traccia dei cambiamenti
  bool settingsChanged = false;
  bool wifiChanged = false;
  bool timeServerChanged = false;
  bool weatherChanged = false;
  
  // Aggiorna le impostazioni WiFi
  if (doc.containsKey("wifi")) {
    JsonObject wifi = doc["wifi"];
    
    if (wifi.containsKey("ssid") && wifi.containsKey("password")) {
      String newSsid = wifi["ssid"].as<String>();
      String newPassword = wifi["password"].as<String>();
      
      // Imposta solo se sono valori diversi
      if (strcmp(config.ssid, newSsid.c_str()) != 0 || 
          strcmp(config.password, newPassword.c_str()) != 0) {
        strncpy(config.ssid, newSsid.c_str(), sizeof(config.ssid) - 1);
        strncpy(config.password, newPassword.c_str(), sizeof(config.password) - 1);
        wifiChanged = true;
        settingsChanged = true;
      }
    }
  }
  
  // Aggiorna le impostazioni del server NTP
  if (doc.containsKey("timeServer")) {
    JsonObject timeServer = doc["timeServer"];
    
    if (timeServer.containsKey("server")) {
      String newServer = timeServer["server"].as<String>();
      if (strcmp(config.ntpServer, newServer.c_str()) != 0) {
        strncpy(config.ntpServer, newServer.c_str(), sizeof(config.ntpServer) - 1);
        timeServerChanged = true;
        settingsChanged = true;
      }
    }
    
    if (timeServer.containsKey("gmtOffset")) {
      long newOffset = timeServer["gmtOffset"].as<long>();
      if (config.gmtOffset_sec != newOffset) {
        config.gmtOffset_sec = newOffset;
        timeServerChanged = true;
        settingsChanged = true;
      }
    }
    
    if (timeServer.containsKey("daylightOffset")) {
      int newOffset = timeServer["daylightOffset"].as<int>();
      if (config.daylightOffset_sec != newOffset) {
        config.daylightOffset_sec = newOffset;
        timeServerChanged = true;
        settingsChanged = true;
      }
    }
  }
  
  // Aggiorna le impostazioni per il meteo
  if (doc.containsKey("weather")) {
    JsonObject weather = doc["weather"];
    
    if (weather.containsKey("city")) {
      String newCity = weather["city"].as<String>();
      if (strcmp(config.city, newCity.c_str()) != 0) {
        strncpy(config.city, newCity.c_str(), sizeof(config.city) - 1);
        weatherChanged = true;
        settingsChanged = true;
      }
    }
    
    if (weather.containsKey("apiKey")) {
      String newApiKey = weather["apiKey"].as<String>();
      if (strcmp(config.api_key, newApiKey.c_str()) != 0) {
        strncpy(config.api_key, newApiKey.c_str(), sizeof(config.api_key) - 1);
        weatherChanged = true;
        settingsChanged = true;
      }
    }
  }
  
  // Salva le impostazioni se necessario
  if (settingsChanged) {
    if (saveConfig()) {
      Serial.println("Impostazioni salvate con successo");
      
      // Invia risposta di successo
      sendResponse(client, "application/json", "{\"success\":true,\"message\":\"Impostazioni salvate con successo\"}");
      
      // Applica le nuove impostazioni se necessario
      if (wifiChanged) {
        reconnectToWiFi();
      }
      
      if (timeServerChanged) {
        setupTimeServer();
      }
      
      if (weatherChanged) {
        updateWeatherData();
      }
    } else {
      Serial.println("Errore nel salvataggio delle impostazioni");
      sendResponse(client, "application/json", "{\"success\":false,\"message\":\"Errore nel salvataggio delle impostazioni\"}", 500);
    }
  } else {
    Serial.println("Nessuna modifica alle impostazioni");
    sendResponse(client, "application/json", "{\"success\":true,\"message\":\"Nessuna modifica necessaria\"}");
  }
}

// API per riavviare il dispositivo
void restartDevice(WiFiClient& client) {
  // Invia una risposta prima di riavviare
  sendResponse(client, "application/json", "{\"success\":true,\"message\":\"Il dispositivo si riavvierà a breve\"}");
  
  // Attendi che il client riceva la risposta
  delay(500);
  
  // Registra l'evento nei log
  Serial.println("Riavvio del dispositivo richiesto dall'utente");
  
  // Riavvia l'ESP
  ESP.restart();
}
