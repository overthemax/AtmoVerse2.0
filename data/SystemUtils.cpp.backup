// Generazione della pagina principale
String generateMainPage() {
  String html = "<!DOCTYPE html><html lang='it'>";
  html += "<head>";
  html += "<meta charset='UTF-8'>";
  html += "<meta name='viewport' content='width=device-width, initial-scale=1.0'>";
  html += "<title>AtmoVerse 2.0</title>";
  html += "<style>" + generateStyleCSS() + "</style>";
  html += "<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css'>";
  html += "</head>";
  html += "<body>";
  html += "<div class='container'>";
  html += "<header>";
  html += "<h1>AtmoVerse 2.0</h1>";
  html += "<nav>";
  html += "<ul>";
  html += "<li><a href='/' class='active'>Home</a></li>";
  html += "<li><a href='/settings.html'>Impostazioni</a></li>";
  html += "<li><a href='/wifi.html'>Scansione WiFi</a></li>";
  html += "</ul>";
  html += "</nav>";
  html += "</header>";
  
  html += "<main>";
  html += "<section id='weather'>";
  html += "<h2>Meteo</h2>";
  html += "<div class='card'>";
  
  // Verifica se i dati meteo sono validi
  if (isWeatherDataValid()) {
    // Formatta la temperatura con un decimale
    char tempStr[10];
    sprintf(tempStr, "%.1f", currentWeather.temp);
    
    // Ottiene l'ora dell'ultimo aggiornamento
    struct tm timeinfo;
    char timeStr[20];
    time_t lastUpdate = getLastUpdateTime();
    localtime_r(&lastUpdate, &timeinfo);
    strftime(timeStr, sizeof(timeStr), "%H:%M:%S", &timeinfo);
    
    // Visualizzazione meteo
    html += "<div class='weather-description'>" + String(currentWeather.description) + "</div>";
    html += "<div class='temperature'>" + String(tempStr) + " &deg;C</div>";
    html += "<div class='weather-icons'>";
    html += "<div class='weather-icon " + String(currentWeather.icon) + "'></div>";
    html += "</div>";
    
    // Dettagli meteo
    html += "<div class='weather-info'>";
    
    html += "<div class='weather-detail'>";
    html += "<div class='value'>" + String(currentWeather.feels_like, 1) + " &deg;C</div>";
    html += "<div class='label'>Percepita</div>";
    html += "</div>";
    
    html += "<div class='weather-detail'>";
    html += "<div class='value'>" + String(currentWeather.humidity, 0) + " %</div>";
    html += "<div class='label'>Umidità</div>";
    html += "</div>";
    
    html += "<div class='weather-detail'>";
    html += "<div class='value'>" + String(currentWeather.pressure, 0) + " hPa</div>";
    html += "<div class='label'>Pressione</div>";
    html += "</div>";
    
    html += "<div class='weather-detail'>";
    html += "<div class='value'>" + String(currentWeather.wind_speed, 1) + " m/s</div>";
    html += "<div class='label'>Vento</div>";
    html += "</div>";
    
    html += "</div>";  // Chiusura weather-info
    
    html += "<div class='system-info'>";
    html += "<p>Ultimo aggiornamento: " + String(timeStr) + "</p>";
    html += "</div>";
  } else {
    // Messaggio di errore se i dati meteo non sono disponibili
    String weatherDesc = "Nuvole Abbondanti";
    
    html += "<div class='weather-description'>" + weatherDesc + "</div>";
    html += "<div class='temperature'>--.- &deg;C</div>";
    html += "<div class='weather-icons'>";
    html += "<div class='weather-icon 03d'></div>";
    html += "</div>";
    
    html += "<div class='weather-info'>";
    html += "<div class='weather-detail'>";
    html += "<div class='value'>--.- &deg;C</div>";
    html += "<div class='label'>Percepita</div>";
    html += "</div>";
    
    html += "<div class='weather-detail'>";
    html += "<div class='value'>-- %</div>";
    html += "<div class='label'>Umidità</div>";
    html += "</div>";
    
    html += "<div class='weather-detail'>";
    html += "<div class='value'>---- hPa</div>";
    html += "<div class='label'>Pressione</div>";
    html += "</div>";
    
    html += "<div class='weather-detail'>";
    html += "<div class='value'>--.- m/s</div>";
    html += "<div class='label'>Vento</div>";
    html += "</div>";
    
    html += "</div>";  // Chiusura weather-info
    
    // Messaggio di errore
    html += "<div class='status-message warning'>";
    html += "<p>Dati meteo non disponibili.</p>";
    html += apMode ? 
           "<p>Collega il dispositivo al WiFi nelle impostazioni.</p>" : 
           "<p>Configurare la città e la chiave API nelle impostazioni.</p>";
    html += "</div>";
  }
  
  html += "</div>";  // Chiusura card
  html += "</section>";
  
  html += generateStatusHTML();
  
  html += "<section id='qrcode'>";
  html += "<h2>Collegamento Rapido</h2>";
  html += "<div class='card'>";
  html += "<div class='qrcode-container'>";
  html += "<p>Scansiona il codice QR per accedere rapidamente all'interfaccia web:</p>";
  html += "<img src='/qrcode.svg' alt='QR Code' class='qrcode-image'>";
  html += "</div>";
  html += "</div>";
  html += "</section>";
  
  html += "</main>";
  
  html += "<footer>";
  html += "<p>&copy; 2025 AtmoVerse 2.0</p>";
  html += "</footer>";
  html += "</div>";
  
  // JavaScript per l'aggiornamento automatico e altre funzionalità
  html += "<script>" + generateJavaScript() + "</script>";
  
  html += "</body></html>";
  return html;
}

// Generazione dello stato del sistema
String generateStatusHTML() {
  String html = "<section id='system-status'>";
  html += "<h2>Stato Sistema</h2>";
  html += "<div class='card'>";
  
  // Informazioni di base
  html += "<div class='system-info'>";
  html += "<p>Modalità: " + String(apMode ? "Access Point" : "Client") + "</p>";
  
  if (!apMode) {
    html += "<p>Connesso a: " + String(config.ssid) + "</p>";
    
    html += "<p>IP: " + WiFi.localIP().toString() + "</p>";
    html += "<p>RSSI: " + String(WiFi.RSSI()) + " dBm</p>";
  } else {
    html += "<p>SSID: AtmoVerse_AP</p>";
    html += "<p>IP: " + WiFi.softAPIP().toString() + "</p>";
  }
  
  // Memoria libera
  html += "<p>Memoria libera: " + String(ESP.getFreeHeap()) + " bytes</p>";
  
  // Tempo di funzionamento
  unsigned long uptime = millis() / 1000;
  unsigned long seconds = uptime % 60;
  unsigned long minutes = (uptime / 60) % 60;
  unsigned long hours = (uptime / 3600);
  
  html += "<p>Tempo di funzionamento: ";
  if (hours > 0) html += String(hours) + "h ";
  if (minutes > 0) html += String(minutes) + "m ";
  html += String(seconds) + "s</p>";
  
  html += "</div>";  // Fine system-info
  
  html += "</div>";  // Fine card
  html += "</section>";
  
  return html;
}

// Generazione del JavaScript per le funzionalità client-side
String generateJavaScript() {
  String js = R"(
    // Funzione per aggiornare automaticamente le informazioni
    function setupAutoRefresh() {
      // Aggiorna la pagina ogni 5 minuti
      setInterval(() => {
        location.reload();
      }, 5 * 60 * 1000);
    }
    
    // Funzione per mostrare messaggi di stato
    function showStatusMessage(message, type) {
      const statusElement = document.createElement('div');
      statusElement.className = `status-message ${type}`;
      statusElement.innerHTML = `<p>${message}</p>`;
      
      // Trova il main container e inserisci il messaggio all'inizio
      const main = document.querySelector('main');
      main.insertBefore(statusElement, main.firstChild);
      
      // Rimuovi il messaggio dopo 5 secondi
      setTimeout(() => {
        statusElement.style.opacity = '0';
        setTimeout(() => statusElement.remove(), 500);
      }, 5000);
    }
    
    // Inizializzazione al caricamento della pagina
    document.addEventListener('DOMContentLoaded', () => {
      setupAutoRefresh();
    });
  )";
  return js;
}

// Generazione della pagina di impostazioni
String generateSettingsPage() {
  String html = "<!DOCTYPE html><html lang='it'>";
  html += "<head>";
  html += "<meta charset='UTF-8'>";
  html += "<meta name='viewport' content='width=device-width, initial-scale=1.0'>";
  html += "<title>Impostazioni - AtmoVerse 2.0</title>";
  html += "<style>" + generateStyleCSS() + "</style>";
  html += "<link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css'>";
  html += "</head>";
  html += "<body>";
  html += "<div class='container'>";
  html += "<header>";
  html += "<h1>AtmoVerse 2.0</h1>";
  html += "<nav>";
  html += "<ul>";
  html += "<li><a href='/'>Home</a></li>";
  html += "<li><a href='/settings.html' class='active'>Impostazioni</a></li>";
  html += "<li><a href='/wifi.html'>Scansione WiFi</a></li>";
  html += "</ul>";
  html += "</nav>";
  html += "</header>";
  
  html += "<main>";
  html += "<section>";
  html += "<h2>Impostazioni</h2>";
  
  // ---------------- FORM WiFi ----------------
  html += "<div id='wifi-settings' class='form-section'>";
  html += "<h3>Configurazione WiFi</h3>";
  html += "<form id='wifi-form'>";
  
  // Sezione WiFi - potenzialmente evidenziata in modalità AP
  html += "<div id='wifi-form-container' ";
  html += apMode ? "class='ap-mode-highlight'" : "";
  html += ">";
  
  // Messaggio per modalità AP
  if (apMode) {
    html += "<div class='ap-mode-message'>";
    html += "<p>Il dispositivo è in modalità Access Point. Configurare la connessione WiFi.</p>";
    html += "</div>";
  }
  
  html += "<div class='form-group'>";
  html += "<label for='ssid'>SSID (Nome rete):</label>";
  html += "<div class='input-group'>";
  
  // Selezione SSID con dropdown popolato da scansione
  html += "<select id='ssid' name='ssid' required>";
  html += "<option value='' disabled ";
  html += (strlen(config.ssid) > 0 ? "" : "selected");
  html += ">-- Seleziona rete --</option>";
  if (strlen(config.ssid) > 0) {
    html += "<option value='" + String(config.ssid) + "' selected>" + String(config.ssid) + "</option>";
  }
  html += "</select>";
  
  // Pulsante per la scansione WiFi
  html += "<button type='button' id='scan-wifi-btn' class='btn secondary'><i class='fas fa-sync-alt'></i> Scansiona</button>";
  html += "</div>"; // chiusura input-group
  
  // Div per mostrare lo stato della scansione
  html += "<div id='scan-status' class='status-text'></div>";
  html += "</div>"; // chiusura form-group
  
  html += "<div class='form-group'>";
  html += "<label for='password'>Password WiFi:</label>";
  html += "<div class='password-field'>";
  html += "<input type='password' id='password' name='password' value='" + String(config.password) + "'>";
  html += "<button type='button' class='toggle-password'><i class='fas fa-eye'></i></button>";
  html += "</div>";
  html += "</div>";
  
  html += "</div>"; // chiusura wifi-form-container
  
  // ---------------- FORM OpenWeatherMap ----------------
  html += "<div class='form-group'>";
  html += "<label for='city'>Città:</label>";
  html += "<input type='text' id='city' name='city' value='" + String(config.city) + "' required>";
  html += "</div>";
  
  html += "<div class='form-group'>";
  html += "<label for='api_key'>Chiave API OpenWeatherMap:</label>";
  html += "<div class='password-field'>";
  html += "<input type='password' id='api_key' name='api_key' value='" + String(config.api_key) + "' required>";
  html += "<button type='button' class='toggle-password'><i class='fas fa-eye'></i></button>";
  html += "</div>";
  html += "</div>";
  
  // ---------------- FORM NTP ----------------
  html += "<div class='form-group'>";
  html += "<label for='ntp'>Server NTP:</label>";
  html += "<input type='text' id='ntp' name='ntp_server' value='" + String(config.ntpServer) + "' required>";
  html += "</div>";
  
  html += "<div class='form-group'>";
  html += "<label for='timezone'>Fuso orario (GMT+):</label>";
  html += "<select id='timezone' name='timezone'>";
  
  for (int i = -12; i <= 14; i++) {
    String selected = (i == config.gmtOffset_sec / 3600) ? "selected" : "";
    html += "<option value='" + String(i * 3600) + "' " + selected + ">" + (i >= 0 ? "+" : "") + String(i) + "</option>";
  }
  
  html += "</select>";
  html += "</div>";
  
  html += "<div class='form-group'>";
  html += "<label>";
  String checked = config.daylightOffset_sec > 0 ? "checked" : "";
  html += "<input type='checkbox' name='daylight_saving' " + checked + "> Ora legale";
  html += "</label>";
  html += "</div>";
  
  // ---------------- AZIONI ----------------
  html += "<div class='actions'>";
  html += "<button type='submit' class='btn primary'><i class='fas fa-save'></i> Salva</button>";
  html += "<button type='button' id='restart-btn' class='btn danger'><i class='fas fa-power-off'></i> Riavvia</button>";
  html += "</div>";
  
  html += "</form>";
  html += "</div>"; // chiusura form-section
  html += "</section>";
  
  // Mostra lo stato del sistema
  html += generateStatusHTML();
  
  html += "</main>";
  
  html += "<footer>";
  html += "<p>&copy; 2025 AtmoVerse 2.0</p>";
  html += "</footer>";
  html += "</div>";
  
  // JavaScript per la pagina delle impostazioni
  html += "<script>" + generateSettingsJS() + "</script>";
  
  html += "</body></html>";
  return html;
}

